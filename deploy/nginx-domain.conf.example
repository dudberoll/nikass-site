    rewrite ^/product/portativnaya-solnechnaya-panel-30w-18-v-2/?$ /catalog/portativnaya-solnechnaya-panel-30w-18-v?variant=SP-30 permanent;
    rewrite ^/product/portativnaya-solnechnaya-panel-50w-18v-2/?$ /catalog/portativnaya-solnechnaya-panel-30w-18-v?variant=SP-50 permanent;
    rewrite ^/product/svintsovo-kislotnyy-germetichnyy-akkumulyator-100-ah/?$ /catalog/category/agm-akkumulyatory permanent;
    rewrite ^/product/vneshniy-akkumulyator-80000-mah-s-bystroy-zaryadkoy/?$ /catalog/category/powerbank permanent;
    rewrite ^/product/zaryadnaya-stantsiya-150-vt-s-solnechnoy-panelyu-48000-mah-2/?$ /catalog/portativnaya-zaryadnaya-stantsiya-sl-54-s-radio-i-bluetooth-150-vt-153-6-vt-ch permanent;
    location ~ ^/contact/?$ {
        return 301 "https://nikass.ru/#contacts";
    }
    # The export lists trashed WooCommerce products as /?post_type=product&p=<id>.
    # Route those no-longer-public ID URLs to the catalog.
    location = / {
        if ($arg_post_type = product) {
            return 301 /catalog;
        }
        try_files $uri $uri/ =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Authorization "";
    }
    location /storage/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }
    location ~ ^/(wp-json(?:/|$)|wp-admin(?:/|$)|wp-content(?:/|$)|wp-includes(?:/|$)|wp-login\.php$|xmlrpc\.php$) {
        proxy_pass https://87.236.16.43;
        proxy_ssl_server_name on;
        proxy_ssl_name nikass.ru;
        proxy_ssl_verify on;
        proxy_ssl_verify_depth 2;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host nikass.ru;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        try_files $uri $uri/index.html =404;
    }
}
