# WooCommerce stays on the existing Beget hosting. Pin its origin to avoid a DNS loop.
server {
    listen 80;
    server_name nikass.ru www.nikass.ru;
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://nikass.ru$request_uri; }
}

server {
    listen 443 ssl;
    server_name www.nikass.ru;
    ssl_certificate /etc/letsencrypt/live/nikass.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nikass.ru/privkey.pem;
    return 301 https://nikass.ru$request_uri;
}

server {
    listen 443 ssl;
    server_name nikass.ru;
    ssl_certificate /etc/letsencrypt/live/nikass.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nikass.ru/privkey.pem;

    root /var/www/nikass/current;
    index index.html;
    client_max_body_size 28m;

    # Legacy WordPress URLs; permanent redirects to the closest current storefront page.
    # Existing page equivalents and the current blog handle the matching content paths.
    rewrite ^/oplata-i-dostavka/?$ /payment-and-delivery permanent;
    rewrite ^/refund_returns/?$ /return-policy permanent;
    rewrite ^/publichnaya-oferta/?$ /payment-and-delivery permanent;
    rewrite ^/my-account/?$ / permanent;
    rewrite ^/nikass-sovremennye-resheniya-dlya-avtonomnoy-energii-i-nadezhnogo-elektrosnabzheniya/?$ /blog permanent;
    # Legacy categories map to their current standalone pages; broad categories use the full catalog.
    rewrite ^/product-category/power-bank/?$ /catalog/category/powerbank permanent;
    rewrite ^/product-category/akkumulyatory/?$ /catalog permanent;
    rewrite ^/product-category/invertory/?$ /catalog permanent;
    rewrite ^/product-category/modif-sinus/?$ /catalog/category/invertory-napryazheniya permanent;
    rewrite ^/product-category/portativnye-stantsii/?$ /catalog/category/portativnye-zaryadnye-stantsii permanent;
    rewrite ^/product-category/seriya-ns-31/?$ /catalog/category/portativnye-zaryadnye-stantsii permanent;
    rewrite ^/product-category/seriya-ns-63/?$ /catalog/category/portativnye-zaryadnye-stantsii permanent;
    rewrite ^/product-category/seriya-ns-66/?$ /catalog/category/portativnye-zaryadnye-stantsii permanent;
