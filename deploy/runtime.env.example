# Copy to /srv/nikass/runtime.env on the VPS. API and scheduler only.
DATABASE_URL=postgresql://nikass_app:APP_PASSWORD@db:5432/nikass?schema=public
JWT_SECRET=
CORS_ORIGINS=https://YOUR_DOMAIN
WEBAPP_ORIGIN=https://YOUR_DOMAIN
TRUST_PROXY=true
TRUSTED_PROXY_CLIENT_IP_HEADER=x-real-ip
PRIVATE_STORAGE_DRIVER=filesystem
PRIVATE_STORAGE_LOCAL_ROOT=.storage
PRIVATE_STORAGE_LOCAL_PUBLIC_URL=https://YOUR_DOMAIN
EMAIL_DELIVERY=disabled

CATALOG_PROVIDER=woocommerce
ORDERS_ENABLED=true
WOOCOMMERCE_PRODUCTS_ENDPOINT=https://YOUR_WOO_SITE/wp-json/wc/v3/products
WOOCOMMERCE_STORE_ENDPOINT=https://YOUR_WOO_SITE/wp-json/wc/store/v1
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

YOO_KASSA_ENABLED=true
YOO_KASSA_TEST_MODE=true
YOO_KASSA_SHOP_ID=
YOO_KASSA_SECRET_KEY=
YOO_KASSA_API_URL=https://api.yookassa.ru
YOO_KASSA_RETURN_URL=https://YOUR_DOMAIN/checkout
YOO_KASSA_FULFILLMENT_MODE=disabled

# Optional. Keep disabled until an actual provider is configured.
AI_PROVIDER=disabled
# For the existing AI chat, replace the line above and set all three values:
# AI_PROVIDER=chat-completions
# AI_API_URL=https://YOUR_AI_PROVIDER/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
