# Copy to /srv/nikass/runtime.env on the VPS. API and scheduler only.
DATABASE_URL=postgresql://nikass_app:APP_PASSWORD@db:5432/nikass?schema=public
JWT_SECRET=
CORS_ORIGINS=https://nikass.ru
WEBAPP_ORIGIN=https://nikass.ru
TRUST_PROXY=true
TRUSTED_PROXY_CLIENT_IP_HEADER=x-real-ip
PRIVATE_STORAGE_DRIVER=filesystem
PRIVATE_STORAGE_LOCAL_ROOT=.storage
PRIVATE_STORAGE_LOCAL_PUBLIC_URL=https://nikass.ru
EMAIL_DELIVERY=disabled

# Required for restock requests; use the same manager bot/chat as the local backend.
ORDER_TELEGRAM_BOT_TOKEN=
ORDER_TELEGRAM_CHAT_ID=

# Shared local snapshot; manager contacts only. No WooCommerce or online payments.
CATALOG_PROVIDER=snapshot
ORDERS_ENABLED=false
YOO_KASSA_ENABLED=false
YOO_KASSA_FULFILLMENT_MODE=disabled

# Optional. Keep disabled until an actual provider is configured.
AI_PROVIDER=disabled
# For the existing AI chat, replace the line above and set all three values:
# AI_PROVIDER=chat-completions
# AI_API_URL=https://YOUR_AI_PROVIDER/v1/chat/completions
# AI_API_KEY=
# AI_MODEL=
