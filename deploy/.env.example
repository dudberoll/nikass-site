# Copy to /srv/nikass/.env on the VPS. Operator-only values; never sent to the API.
# Use independent hex passwords without URL escaping. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
MIGRATION_DATABASE_URL=postgresql://postgres:POSTGRES_PASSWORD@db:5432/nikass?schema=public
# Only for the first db:deploy. Use a real address and a strong unique password.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
