---
import StoreFooter from "../../components/StoreFooter.astro";
import StoreHeader from "../../components/StoreHeader.astro";
import BreadcrumbStructuredData from "../../components/BreadcrumbStructuredData.astro";
import CanonicalLink from "../../components/CanonicalLink.astro";
import OpenGraphMeta from "../../components/OpenGraphMeta.astro";
import ProductStructuredData from "../../components/ProductStructuredData.astro";
import ProductVariantSelector from "../../components/ProductVariantSelector";
import { blogEntries } from "../../data/blog";
import { DISCOUNTED_PRODUCTS_LABEL, DISCOUNTED_PRODUCTS_PATH, detailLines, detailRows, displayProductSku, getCatalogCategoryPath, getProductPrice, loadCatalogProducts, relatedProducts, type Product } from "../../data/catalog";
import { optimizeCatalogImages } from "../../data/catalog-images";

import "../../styles/global.css";

export async function getStaticPaths() {
  const products = await optimizeCatalogImages(await loadCatalogProducts("all"));
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const indexableProduct = !product.demo && product.slug !== "test";
const characteristicSets = product.variantCharacteristics
  ? Object.entries(product.variantCharacteristics)
  : [[product.variants[0]?.sku ?? "default", product.characteristics] as const];
const initialVariantSku = product.variants[0]?.sku ?? "default";
const packageSets = product.variantPackageContents
  ? Object.entries(product.variantPackageContents)
  : [[initialVariantSku, product.packageContents] as const];
const warrantySets = product.variantWarranties
  ? Object.entries(product.variantWarranties)
  : [[initialVariantSku, product.warranty ?? ""] as const];
const related = relatedProducts(product, await optimizeCatalogImages(await loadCatalogProducts("all")));
const catalogPath = product.discounted ? DISCOUNTED_PRODUCTS_PATH : getCatalogCategoryPath(product.category) ?? "/catalog";
const catalogLabel = product.discounted ? DISCOUNTED_PRODUCTS_LABEL : product.category;
const productTitle = `${product.name} — NIKASS`;
const productDescription = product.description || product.name;
const breadcrumbItems = [
  { name: "Главная", url: "/" },
  ...(product.discounted
    ? [{ name: DISCOUNTED_PRODUCTS_LABEL, url: DISCOUNTED_PRODUCTS_PATH }]
    : [{ name: "Каталог", url: "/catalog" }, { name: product.category, url: catalogPath }]),
  { name: product.name },
];
const articleSlugByCategory: Record<string, string> = {
  "Портативные зарядные станции": "energy-at-dacha",
  "Солнечные панели": "sun-in-the-system",
  "AGM аккумуляторы": "how-to-build-an-autonomous-system",
  "LiFePO₄ аккумуляторы": "how-to-build-an-autonomous-system",
  "Инверторы напряжения": "how-to-build-an-autonomous-system",
  "Гибридные инверторы": "how-to-build-an-autonomous-system",
  "Системы хранения энергии": "how-to-build-an-autonomous-system",
  POWERBANK: "charging-on-the-road",
};
const article = blogEntries.find((entry) => entry.slug === articleSlugByCategory[product.category]);
const articleLink = article && `/blog/${article.slug}?from=${encodeURIComponent(`/catalog/${product.slug}`)}`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    {indexableProduct && <CanonicalLink />}
    <meta name="viewport" content="width=device-width" />
    {(product.demo || product.slug === "test") && <meta name="robots" content="noindex,follow" />}
    <meta name="description" content={productDescription} />
    {indexableProduct && <OpenGraphMeta title={productTitle} description={productDescription} image={product.variants[0]?.image ?? product.image} imageAlt={product.name} />}
    {indexableProduct && <BreadcrumbStructuredData items={breadcrumbItems} />}
    {indexableProduct && <ProductStructuredData product={product} />}
    <link rel="icon" href="/favicon.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{productTitle}</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main product-page" id="main-content" data-product-slug={product.slug}>
      <nav class="store-breadcrumb" aria-label="Хлебные крошки">
        <a href="/">Главная</a> / {product.discounted
          ? <a href={catalogPath} data-catalog-back>{DISCOUNTED_PRODUCTS_LABEL}</a>
          : <><a href="/catalog">Каталог</a> / <a href={catalogPath} data-catalog-back>{product.category}</a></>} / <span>{product.name}</span>
      </nav>
      <section class="product-layout">
        <div class="product-gallery-wrap"><div class="product-gallery">{product.discounted && product.images?.[0] ? <a class="product-gallery-original" href={product.images[0]} target="_blank" rel="noreferrer" aria-label={`Открыть полноразмерное фото товара ${product.name}`}><img src={product.variants[0]?.image ?? product.image} srcset={product.variants[0]?.imageSrcSet ?? product.imageSrcSet} sizes="(max-width: 900px) calc(100vw - 40px), (max-width: 1200px) 55vw, 600px" alt={product.name} data-product-image /></a> : <img src={product.variants[0]?.image ?? product.image} srcset={product.variants[0]?.imageSrcSet ?? product.imageSrcSet} sizes="(max-width: 900px) calc(100vw - 40px), (max-width: 1200px) 55vw, 600px" alt={product.name} data-product-image />}</div>{product.discounted && product.images && product.images.length > 1 && <div class="product-defect-images">{product.images.slice(1).map((image, index) => { const optimizedImage = product.galleryImages?.[index]; return <a href={image} target="_blank" rel="noreferrer" aria-label={`Открыть полноразмерное фото товара ${index + 2}`}><img src={optimizedImage?.src ?? image} srcset={optimizedImage?.srcSet} sizes="(max-width: 900px) calc((100vw - 64px) / 3), 190px" alt={`${product.name} — фото ${index + 2}`} loading="lazy" /></a>; })}</div>}</div>
        <div class="product-info">
          <p class="store-eyebrow"><a href={catalogPath}>{catalogLabel}</a> / {product.category}</p>
          <h1>{product.name}</h1>
          <p class="product-sku">Артикул: {displayProductSku(product)}</p>
          {product.demo && <p class="store-product-card-description">Тестовый экземпляр — для проверки каталога и корзины, без оформления заказа.</p>}
          <ProductVariantSelector {product} client:load />
          {product.defectDescription && <div class="product-description"><h2>Причина уценки</h2><p>{product.defectDescription}</p></div>}
          {(product.description || article) && <div class="product-description"><h2>Описание</h2>{product.description && <p>{product.description}</p>}{article && articleLink && <><p class="product-article-teaser">{article.summary}</p><a class="store-primary-button" href={articleLink}>Смотреть полностью</a></>}</div>}
        </div>
      </section>

      <section class="product-details">
        {characteristicSets.some(([, value]) => detailRows(value).length > 0) && <details class="product-detail-disclosure product-characteristics-disclosure" name="product-details"><summary><span>Характеристики</span></summary>{characteristicSets.map(([sku, value]) => <table class="product-specs" data-product-specs-sku={sku} data-product-detail-sku={sku} hidden={sku !== initialVariantSku}><tbody>{detailRows(value).map(([label, rowValue]) => <tr><th scope="row">{label}</th><td>{rowValue}</td></tr>)}</tbody></table>)}</details>}
        <details class="product-detail-disclosure" name="product-details"><summary><span>Комплектация</span></summary>{packageSets.map(([sku, value]) => <div data-product-detail-sku={sku} hidden={sku !== initialVariantSku}>{value ? <ul>{detailLines(value).map((line) => <li>{line}</li>)}</ul> : <p>Комплектация пока не указана.</p>}</div>)}</details>
        <details class="product-detail-disclosure" name="product-details"><summary><span>Гарантия</span></summary>{warrantySets.map(([sku, value]) => <p data-product-detail-sku={sku} hidden={sku !== initialVariantSku}>{value || "Гарантия пока не указана."}</p>)}</details>
        <details class="product-detail-disclosure" name="product-details"><summary><span>Доставка</span></summary><p>Доставим по России. Точную стоимость и срок покажем на этапе оформления заказа.</p></details>
      </section>

      {related.length > 0 && <section class="product-related" aria-labelledby="related-title">
        <p class="store-eyebrow">NIKASS / СВЯЗАННЫЕ ТОВАРЫ</p><h2 id="related-title">Рекомендуем в комплект</h2>
        <div class="orbea-bestsellers-grid">{related.map((item) => <a class="orbea-bestseller-card" href={`/catalog/${item.slug}`}><div class="orbea-bestseller-image"><img src={item.image} srcset={item.imageSrcSet} sizes="(max-width: 600px) 220px, 240px" alt={item.name} loading="lazy" /></div><div class="orbea-bestseller-copy"><p>{item.category}</p><h3>{item.name}</h3><div class="orbea-bestseller-price"><strong>{getProductPrice(item).label}</strong>{getProductPrice(item).oldPriceLabel && <del>{getProductPrice(item).oldPriceLabel}</del>}</div></div></a>)}</div>
      </section>}
    </main>
    <StoreFooter />

    <script is:inline>
      const catalogBackLink = document.querySelector("[data-catalog-back]");
      catalogBackLink?.addEventListener("click", (event) => {
        const previousPage = document.referrer ? new URL(document.referrer) : undefined;
        if (previousPage?.origin === location.origin && previousPage.pathname.replace(/\/$/, "") === new URL(catalogBackLink.href).pathname && history.length > 1) {
          event.preventDefault();
          history.back();
        }
      });

      const modelDetails = [...document.querySelectorAll("[data-product-detail-sku]")];
      const selectModelDetails = (sku) => {
        const selectedSku = modelDetails.find((block) => block.dataset.productDetailSku === sku)?.dataset.productDetailSku ?? modelDetails[0]?.dataset.productDetailSku;
        modelDetails.forEach((block) => { block.hidden = block.dataset.productDetailSku !== selectedSku; });
      };
      const productImage = document.querySelector("[data-product-image]");
      const productSku = document.querySelector(".product-sku");
      const productStructuredData = document.querySelector("[data-product-structured-data]");
      window.addEventListener("nikass:product-variant-change", (event) => {
        selectModelDetails(event.detail?.sku ?? "");
        if (event.detail?.displaySku && productSku) productSku.textContent = `Артикул: ${event.detail.displaySku}`;
        if (event.detail?.image) productImage?.setAttribute("src", event.detail.image);
        if (event.detail?.imageSrcSet) productImage?.setAttribute("srcset", event.detail.imageSrcSet);
        else productImage?.removeAttribute("srcset");
        if (event.detail?.structuredData && productStructuredData) productStructuredData.textContent = event.detail.structuredData;
      });
    </script>

  </body>
</html>
