---
import StoreFooter from "../../components/StoreFooter.astro";
import StoreHeader from "../../components/StoreHeader.astro";
import ProductVariantSelector from "../../components/ProductVariantSelector";
import { detailLines, detailRows, formatPrice, loadCatalogProducts, relatedProducts, type Product } from "../../data/catalog";

import "../../styles/global.css";

export async function getStaticPaths() {
  const products = await loadCatalogProducts();
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
const characteristics = detailRows(product.characteristics);
const packageContents = detailLines(product.packageContents);
const initialVariantKey = product.variants[0]?.label.match(/\bL[1-4]\b/)?.[0] ?? "";
const related = relatedProducts(product, await loadCatalogProducts());
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={product.description || product.name} />
    <link rel="icon" href="/favicon.ico" />
    <title>{product.name} — NIKASS</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main product-page" id="main-content">
      <p class="store-breadcrumb"><a href="/catalog">← Вернуться назад</a></p>
      <section class="product-layout">
        <div class="product-gallery"><img src={product.image} alt={product.name} /></div>
        <div class="product-info">
          <p class="store-eyebrow"><a href="/catalog">Каталог</a> / {product.category}</p>
          <h1>{product.name}</h1>
          <p class="product-sku">Артикул: {product.sku}</p>
          <ProductVariantSelector {product} client:load />
          {product.description && <div class="product-description"><h2>Описание</h2><p>{product.description}</p></div>}
        </div>
      </section>

      <section class="product-details">
        {characteristics.length > 0 && <details class="product-detail-disclosure"><summary><span>Характеристики</span></summary><table class="product-specs"><tbody>{characteristics.map(([label, value]) => {
          const variantKey = label.match(/\bL[123]\b/)?.[0];
          return <tr data-product-spec-variant={variantKey} hidden={Boolean(variantKey && variantKey !== initialVariantKey)}><th scope="row">{label}</th><td>{value}</td></tr>;
        })}</tbody></table></details>}
        {packageContents.length > 0 && <details class="product-detail-disclosure"><summary><span>Комплектация</span></summary><ul>{packageContents.map((line) => <li>{line}</li>)}</ul></details>}
        <details class="product-detail-disclosure"><summary><span>Доставка</span></summary><p>Доставим по России. Точную стоимость и срок покажем на этапе оформления заказа.</p></details>
      </section>

      {related.length > 0 && <section class="product-related" aria-labelledby="related-title">
        <p class="store-eyebrow">NIKASS / СВЯЗАННЫЕ ТОВАРЫ</p><h2 id="related-title">С этим товаром покупают</h2>
        <div class="orbea-bestsellers-grid">{related.map((item) => <a class="orbea-bestseller-card" href={`/catalog/${item.slug}`}><div class="orbea-bestseller-image"><img src={item.image} alt={item.name} loading="lazy" /></div><div class="orbea-bestseller-copy"><p>{item.category}</p><h3>{item.name}</h3><div><strong>{formatPrice(item.price)}</strong>{item.oldPrice && <del>{formatPrice(item.oldPrice)}</del>}</div></div></a>)}</div>
      </section>}
    </main>
    <StoreFooter />

    <script is:inline>
      const specificationRows = [...document.querySelectorAll("[data-product-spec-variant]")];
      const selectModelSpecifications = (label) => {
        const model = label.match(/\bL[1-4]\b/)?.[0] ?? "";
        specificationRows.forEach((row) => { row.hidden = Boolean(model && row.dataset.productSpecVariant !== model); });
      };
      window.addEventListener("nikass:product-variant-change", (event) => selectModelSpecifications(event.detail?.label ?? ""));
    </script>
  </body>
</html>
