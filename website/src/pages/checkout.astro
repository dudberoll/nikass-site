---
import Checkout from "../components/Checkout";
import StoreFooter from "../components/StoreFooter.astro";
import StoreHeader from "../components/StoreHeader.astro";
import "../styles/global.css";

function publicUrl(value: string, { httpsOnly = false } = {}) {
  if (!value) return "";
  const url = new URL(value);
  if ((httpsOnly && url.protocol !== "https:") || (!httpsOnly && !["http:", "https:"].includes(url.protocol))) throw new Error(`Недопустимый публичный URL: ${value}`);
  return url.href;
}

const apiBase = publicUrl(import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000").replace(/\/$/, "");
const testMode = import.meta.env.PUBLIC_TEST_MODE === "true";
const privacyUrl = publicUrl(import.meta.env.PUBLIC_PRIVACY_URL ?? "", { httpsOnly: true });
const termsUrl = publicUrl(import.meta.env.PUBLIC_TERMS_URL ?? "", { httpsOnly: true });
const yandexSuggestApiKey = import.meta.env.PUBLIC_YANDEX_SUGGEST_API_KEY ?? "";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Безопасное оформление заказа NIKASS без регистрации." />
    <link rel="icon" href="/favicon.ico" />
    <title>Оформление заказа — NIKASS</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main checkout-page" id="main-content">
      <p class="store-eyebrow">NIKASS / ОФОРМЛЕНИЕ</p>
      <h1>Ваш заказ</h1>
      <p class="checkout-lead">{testMode ? "Сейчас доступна тестовая оплата: деньги не списываются, реальный заказ не создаётся. Результат проверки появится на этой странице." : "После оплаты результат подтвердится на этой странице. В рабочем режиме менеджер свяжется с Вами в течение 1 часа и уточнит способ получения заказа."}</p>
      <Checkout {apiBase} {privacyUrl} {termsUrl} {yandexSuggestApiKey} {testMode} client:load />
    </main>
    <StoreFooter />
  </body>
</html>
