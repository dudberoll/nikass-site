---
import AboutSection from "../components/AboutSection.astro";
import StoreFooter from "../components/StoreFooter.astro";
import StoreHeader from "../components/StoreHeader.astro";
import "../styles/global.css";
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="О NIKASS — решения для автономного и резервного электроснабжения." />
    <link rel="icon" href="/favicon.ico" />
    <title>О NIKASS — автономная энергия</title>
  </head>
  <body class="store-page about-page">
    <StoreHeader />
    <main id="main-content">
      <h1 class="sr-only">О NIKASS</h1>
      <AboutSection />
    </main>
    <StoreFooter />
  </body>
</html>
