---
import CatalogExplorer from "../components/CatalogExplorer";
import StoreFooter from "../components/StoreFooter.astro";
import StoreHeader from "../components/StoreHeader.astro";
import { HERO_CATEGORIES, loadCatalogProducts } from "../data/catalog";
import "../styles/global.css";

const products = await loadCatalogProducts();
const categories = HERO_CATEGORIES;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Каталог NIKASS: зарядные станции, солнечные панели, инверторы и аккумуляторы." />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>Каталог NIKASS — автономная энергия</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main" id="main-content">
      <section class="store-intro catalog-intro">
        <h1>Каталог</h1>
        <p>Решения для дома, дороги, работы и резервного питания.</p>
      </section>
      <CatalogExplorer products={products} categories={categories} client:load />
    </main>
    <StoreFooter />
  </body>
</html>
