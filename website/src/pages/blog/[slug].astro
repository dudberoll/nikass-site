---
import StoreFooter from "../../components/StoreFooter.astro";
import StoreHeader from "../../components/StoreHeader.astro";
import { blogEntries, type BlogEntry } from "../../data/blog";
import { formatPrice, HERO_CATEGORIES, loadCatalogProducts } from "../../data/catalog";
import "../../styles/global.css";

type Props = { entry: BlogEntry };

export function getStaticPaths() {
  return blogEntries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const catalogProducts = entry.slug === "energy-at-dacha" || entry.recommendedProductSlugs?.length
  ? await loadCatalogProducts()
  : [];
const recommendedProducts = entry.recommendedProductSlugs
  ? entry.recommendedProductSlugs.map((slug) => {
      const product = catalogProducts.find((candidate) => candidate.slug === slug);
      if (!product) throw new Error(`Blog entry ${entry.slug} references unknown catalog product: ${slug}`);
      return product;
    })
  : [
      catalogProducts.find((product) => product.category === "Портативные зарядные станции"),
      catalogProducts.find((product) => product.category === "Солнечные панели"),
    ].filter((product) => product !== undefined);
const returnCategoryByArticle: Record<string, string> = {
  "energy-at-dacha": "Портативные зарядные станции",
  "sun-in-the-system": "Солнечные панели",
  "charging-on-the-road": "POWERBANK",
};
const defaultReturnCategory = returnCategoryByArticle[entry.slug];
const defaultReturnPath = defaultReturnCategory
  ? `/catalog?category=${encodeURIComponent(defaultReturnCategory)}`
  : "/catalog";
const allowedCatalogCategories = HERO_CATEGORIES.flatMap(({ title, label, category }) => [title, label, category]);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={entry.summary} />
    <link rel="icon" href="/favicon.ico" />
    <title>{entry.title} — Блог NIKASS</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main blog-article-page" id="main-content">
      <a class="store-primary-button blog-return-button" href={defaultReturnPath} data-return-to-catalog data-default-href={defaultReturnPath} data-catalog-categories={JSON.stringify(allowedCatalogCategories)}>Вернуться в каталог</a>
      <nav class="store-breadcrumb" aria-label="Хлебные крошки"><a href="/">Главная</a> / <a href="/blog">Блог</a> / <span>{entry.title}</span></nav>
      <article class="blog-article">
        <header class="blog-article-header">
          <h1>{entry.title}</h1>
          <p>{entry.summary}</p>
        </header>
        {!entry.hideImage && <figure class="blog-article-image"><img src={`/assets/images/${entry.image}`} alt={entry.title} /></figure>}
        <div class="blog-article-body">
          {entry.blocks
            ? entry.blocks.map((block) => {
                if (block.type === "paragraph") return <p>{block.text}</p>;
                if (block.type === "heading") return <h2>{block.text}</h2>;
                if (block.type === "list") {
                  return block.ordered
                    ? <ol class="blog-article-list">{block.items.map((item) => <li>{item}</li>)}</ol>
                    : <ul class="blog-article-list">{block.items.map((item) => <li>{item}</li>)}</ul>;
                }
                if (block.type === "links") return <ul class="blog-article-list blog-article-links">{block.items.map((item) => <li><a href={item.href} target="_blank" rel="noreferrer">{item.text}</a></li>)}</ul>;
                if (block.type === "table") return (
                  <div class="blog-article-table-wrap">
                    <table class="blog-article-table">
                      <thead><tr>{block.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                      <tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
                    </table>
                  </div>
                );
                return <aside class={`blog-article-callout blog-article-callout-${block.tone}`}><strong>{block.title}</strong><p>{block.text}</p></aside>;
              })
            : entry.content.map((sentence) => <p>{sentence}</p>)}
        </div>
        <a class="store-primary-button" href="/blog">Все статьи</a>
        {recommendedProducts.length > 0 && <section class="orbea-bestsellers blog-recommended-products" aria-labelledby="recommended-products-title">
          <div class="orbea-bestsellers-intro">
            <div>
              <p class="orbea-section-kicker">NIKASS / К СТАТЬЕ</p>
              <h2 id="recommended-products-title">Рекомендуемые товары</h2>
            </div>
          </div>
          <div class="orbea-bestsellers-grid">
            {recommendedProducts.map((product) => (
              <a class="orbea-bestseller-card" href={`/catalog/${product.slug}`}>
                <div class="orbea-bestseller-image"><img src={product.image} alt={product.name} loading="lazy" /></div>
                <div class="orbea-bestseller-copy">
                  <p>{product.category}</p>
                  <h3>{product.name}</h3>
                  <div><strong>{formatPrice(product.price)}</strong>{product.oldPrice && <del>{formatPrice(product.oldPrice)}</del>}</div>
                </div>
              </a>
            ))}
          </div>
        </section>}
      </article>
    </main>
    <StoreFooter />
    <script is:inline>
      const returnToCatalog = document.querySelector("[data-return-to-catalog]");
      const catalogCategories = new Set(JSON.parse(returnToCatalog?.dataset.catalogCategories ?? "[]"));
      const getCatalogReturnPath = (value) => {
        if (!value) return undefined;
        try {
          const url = new URL(value, window.location.origin);
          if (url.origin !== window.location.origin) return undefined;
          if (url.pathname === "/catalog" || url.pathname === "/catalog/") {
            const category = url.searchParams.get("category");
            return category && catalogCategories.has(category) ? `/catalog?category=${encodeURIComponent(category)}` : "/catalog";
          }
          const product = url.pathname.match(/^\/catalog\/([a-z0-9-]+)\/?$/);
          if (!product) return undefined;
          const variant = url.searchParams.get("variant");
          return `/catalog/${product[1]}${variant ? `?variant=${encodeURIComponent(variant)}` : ""}`;
        } catch {
          return undefined;
        }
      };
      const from = new URLSearchParams(window.location.search).get("from");
      returnToCatalog.href = getCatalogReturnPath(from)
        ?? getCatalogReturnPath(document.referrer)
        ?? returnToCatalog.dataset.defaultHref
        ?? "/catalog";
    </script>
  </body>
</html>
