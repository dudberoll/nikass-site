---
import AiComponentsDemo from "../components/AiComponentsDemo";
import { getProductPrice, loadCatalogProducts } from "../data/catalog";
import "../styles/global.css";

const apiBase = (import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000").replace(/\/$/, "");
const chatProducts = (await loadCatalogProducts()).map((product) => ({
  slug: product.slug,
  name: product.name,
  category: product.category,
  image: product.image,
  priceLabel: getProductPrice(product).label,
  oldPriceLabel: getProductPrice(product).oldPriceLabel,
}));
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <meta name="description" content="Демонстрация компонентов чат-бота NIKASS." />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>Chat — NIKASS</title>
  </head>
  <body class="ai-components-page">
    <main class="ai-components-main">
      <AiComponentsDemo {apiBase} products={chatProducts} client:load />
    </main>
  </body>
</html>
