---
import CartView from "../components/CartView";
import StoreFooter from "../components/StoreFooter.astro";
import StoreHeader from "../components/StoreHeader.astro";
import { loadCatalogProducts } from "../data/catalog";
import "../styles/global.css";

const products = await loadCatalogProducts("all");
const apiUrl = new URL(import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000");
const localApi = ["localhost", "127.0.0.1", "[::1]"].includes(apiUrl.hostname);
if (apiUrl.username || apiUrl.password || (apiUrl.protocol !== "https:" && (apiUrl.protocol !== "http:" || !localApi))) throw new Error("Для оформления нужен HTTPS; HTTP разрешён только на локальном компьютере.");
const apiBase = apiUrl.href.replace(/\/$/, "");
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Корзина NIKASS." />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/favicon.png" sizes="120x120" />
    <title>Корзина — NIKASS</title>
  </head>
  <body class="store-page">
    <StoreHeader />
    <main class="store-main cart-page" id="main-content">
      <p class="store-eyebrow">NIKASS / КОРЗИНА</p>
      <h1>Ваша корзина</h1>
      <CartView products={products} {apiBase} client:load />
    </main>
    <StoreFooter />
  </body>
</html>
