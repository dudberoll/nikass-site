---
import "../styles/global.css";
import ProductCard from "../components/ProductCard";
import AboutSection from "../components/AboutSection.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import StoreHeader from "../components/StoreHeader.astro";
import CookieNotice from "../components/CookieNotice.astro";
import StoreChat from "../components/StoreChat.astro";
import { HERO_CATEGORIES, loadCatalogProducts } from "../data/catalog";
import { storyEntries } from "../data/blog";

const products = await loadCatalogProducts();

const bikes = [
  { id: "stations", category: "Портативные зарядные станции", title: "Зарядные станции", body: "Энергия в пути", cta: "Смотреть решения", image: "energy-stations.webp" },
  { id: "inverters", category: "Инверторы напряжения", title: "Инверторы напряжения", body: "Стабильное питание", cta: "Выбрать инвертор", image: "energy-inverters.webp" },
  { id: "panels", category: "Солнечные панели", title: "Солнечные панели", body: "Зарядка от солнца", cta: "Выбрать панель", image: "energy-panels.webp" },
  { id: "batteries", category: "AGM аккумуляторы", title: "Аккумуляторы", body: "Запас автономности", cta: "Выбрать аккумулятор", image: "energy-batteries.webp" },
];

const stories = storyEntries;
const mobileStories = storyEntries.filter((story) => !["backup-power-for-work", "more-autonomy-less-dependence"].includes(story.slug));

const footerGroups = [
  { title: "Магазин", links: [{ label: "Каталог", href: "/catalog" }, { label: "Блог", href: "/blog" }, { label: "Корзина", href: "/cart" }] },
  { title: "Поддержка", links: [{ label: "Оплата и доставка", href: "/payment-and-delivery" }, { label: "Политика возврата", href: "/return-policy" }, { label: "Сервисный центр", href: "/service-center" }] },
];

const bestSellerSlugs = [
  "portativnaya-zaryadnaya-stantsiya-150-vt-48000-mah",
  "portativnaya-zaryadnaya-stantsiya-150-vt-48000-mah-153-6wh",
  "portativnaya-zaryadnaya-stantsiya-150-vt-48000-mah-2",
  "portativnaya-elektrostantsiya-168000-mah-600w",
];
const bestSellers = bestSellerSlugs.flatMap((slug) => products.filter((product) => product.slug === slug));
const heroCategories = HERO_CATEGORIES;
const formatHeroTitle = (title: string) => title.replace("LiFePO4", "LiFePO₄");
const heroInitialIndex = 0;
const heroPosition = (index: number) => {
  let position = index - heroInitialIndex;
  if (position > heroCategories.length / 2) position -= heroCategories.length;
  return position;
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="NIKASS — автономная энергия для дома, дороги и работы." />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"NIKASS","url":"https://nikass.ru","logo":"https://nikass.ru/assets/images/nikass-smart-selection-logo.png"}</script>
    <link rel="icon" href="/favicon.png" type="image/png" sizes="120x120" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>NIKASS | Автономная энергия</title>
  </head>
  <body>
    <div class="orbea-page">
      <StoreHeader />

      <main id="main-content">
        <section class="orbea-hero orbea-hero-featured">
          <div class="orbea-hero-copy">
            <h1>Энергия без привязки</h1>
            <p>Надёжные решения для дома, дороги и работы — там, где нужна свобода от розетки.</p>
            <div class="orbea-hero-actions">
              <a class="orbea-button orbea-button-no-arrow" href="/catalog">Смотреть каталог</a>
              <a class="orbea-button orbea-button-dark" href="#custom">Подобрать решение</a>
            </div>
          </div>
          <div class="orbea-hero-products" role="region" aria-roledescription="карусель" aria-label="Категории товаров" data-hero-carousel>
            <p class="orbea-hero-current-category" data-hero-current-category>{formatHeroTitle(heroCategories[heroInitialIndex].title)}</p>
            <button class="orbea-hero-arrow orbea-hero-arrow-previous" type="button" aria-label="Предыдущая категория" aria-controls="hero-products-viewport" data-hero-previous>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <div class="orbea-hero-products-viewport" id="hero-products-viewport" data-hero-viewport>
            {heroCategories.map((category, index) => (
              <a
                class="orbea-hero-product-card"
                href={`/catalog?category=${encodeURIComponent(category.title)}`}
                aria-label={`${index === heroInitialIndex ? "Открыть" : "Показать"} категорию «${formatHeroTitle(category.title)}»`}
                aria-current={index === heroInitialIndex ? "true" : undefined}
                aria-hidden={Math.abs(heroPosition(index)) > 1 ? "true" : undefined}
                tabindex={Math.abs(heroPosition(index)) > 1 ? -1 : undefined}
                data-hero-product
                data-product-name={formatHeroTitle(category.title)}
                data-hero-position={heroPosition(index)}
              >
                <span class="orbea-hero-product-media"><img src={category.image} alt={formatHeroTitle(category.title)} loading={index === heroInitialIndex ? "eager" : "lazy"} decoding="async" /></span>
                <span class="orbea-hero-product-name">{category.title === "ПОРТАТИВНЫЕ ЗАРЯДНЫЕ СТАНЦИИ" ? <>ПОРТАТИВНЫЕ<br />ЗАРЯДНЫЕ СТАНЦИИ</> : category.title === "СИСТЕМЫ ХРАНЕНИЯ ЭНЕРГИИ" ? <><span>СИСТЕМЫ ХРАНЕНИЯ</span><span>ЭНЕРГИИ</span></> : formatHeroTitle(category.title)}</span>
              </a>
            ))}
            </div>
            <button class="orbea-hero-arrow orbea-hero-arrow-next" type="button" aria-label="Следующая категория" aria-controls="hero-products-viewport" data-hero-next>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </button>
            <span class="sr-only" aria-live="polite" data-hero-status>{formatHeroTitle(heroCategories[heroInitialIndex].title)}, {heroInitialIndex + 1} из {heroCategories.length}</span>
          </div>
        </section>

        <section class="orbea-bestsellers" id="bestsellers">
          <div class="orbea-bestsellers-intro">
            <div>
              <p class="orbea-section-kicker">NIKASS / ВЫБОР ПОКУПАТЕЛЕЙ</p>
              <h2>Хиты продаж</h2>
            </div>
            <a class="orbea-button orbea-button-dark" href="/catalog">Смотреть весь каталог</a>
          </div>
          <div class="orbea-bestsellers-carousel" data-bestsellers-carousel>
            <button class="orbea-hero-arrow orbea-bestsellers-arrow orbea-bestsellers-arrow-previous" type="button" aria-label="Предыдущие хиты продаж" data-bestsellers-previous>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <div class="orbea-bestsellers-grid" data-bestsellers-viewport>
            {bestSellers.map((product) => <ProductCard product={product} appearance="bestseller" client:load />)}
            </div>
            <button class="orbea-hero-arrow orbea-bestsellers-arrow orbea-bestsellers-arrow-next" type="button" aria-label="Следующие хиты продаж" data-bestsellers-next>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </button>
          </div>
        </section>

        <section class="orbea-section-intro"><h2>Выберите свой источник энергии</h2></section>
        <section class="orbea-bike-grid">
          {bikes.map((bike) => (
            <article class="orbea-bike-card" id={bike.id}>
              <img src={`/assets/images/${bike.image}`} alt="" />
              <div class="orbea-bike-shade"></div>
              <div class="orbea-bike-copy"><h3>{bike.title}</h3><strong>{bike.body}</strong><a class="orbea-button" href={`/catalog?category=${encodeURIComponent(bike.category)}`}>{bike.cta}</a></div>
            </article>
          ))}
        </section>

        <section class="orbea-video-section orbea-custom-video" id="custom">
          <img class="orbea-video" src="/assets/images/autonomy-system.png" alt="Зарядные станции, аккумуляторы и солнечные панели NIKASS на природе" />
          <div class="orbea-video-overlay"></div>
          <div class="orbea-video-copy">
            <h2>Соберите свою систему автономности</h2>
            <p>Выберите станцию, панель и аккумулятор под свой сценарий — для спокойствия дома, поездок и рабочих задач.</p>
            <div class="orbea-video-actions">
              <a class="orbea-button" href="/catalog">Перейти в каталог</a>
              <button class="orbea-button" type="button" aria-controls="nikass-chat-widget" aria-expanded="false" data-chat-open>Получить консультацию</button>
            </div>
          </div>
        </section>

        <section class="orbea-stories" id="stories">
          <div class="orbea-stories-intro">
            <h2>Что нужно именно вам?</h2>
            <p>Разбираем реальные сценарии: как пережить отключение, зарядить технику в дороге и собрать систему под свои задачи.</p>
            <a class="orbea-button orbea-button-dark orbea-button-no-arrow" href="/blog">Все статьи</a>
          </div>
          <div class="orbea-story-row orbea-story-row-desktop" role="region" aria-label="Статьи блога" tabindex="0">
            {stories.map((story, index) => {
              const title = index === 1 ? "В дорогу" : story.title;
              return (
              <a class="orbea-story-card" href={`/blog/${story.slug}`} aria-label={`Открыть статью: ${title}`} style={`background-image:url('/assets/images/${story.image}')`}>
                <div class="orbea-story-shade"></div>
                <div class="orbea-story-meta"><span>{story.date}</span>{story.tag && <span>{story.tag}</span>}</div>
                <h3>{title}</h3>
              </a>
              );
            })}
          </div>
          <div class="orbea-story-row orbea-story-row-mobile" role="region" aria-label="Статьи блога" tabindex="0">
            {mobileStories.map((story, index) => {
              const title = index === 1 ? "В дорогу" : story.title;
              return (
              <a class="orbea-story-card" href={`/blog/${story.slug}`} aria-label={`Открыть статью: ${title}`} style={`background-image:url('/assets/images/${story.image}')`}>
                <div class="orbea-story-shade"></div>
                <div class="orbea-story-meta"><span>{story.date}</span>{story.tag && <span>{story.tag}</span>}</div>
                <h3>{title}</h3>
              </a>
              );
            })}
          </div>
        </section>
        <AboutSection compact />
        <ReviewsSection />
        <section class="orbea-contact-cta" id="contacts" aria-labelledby="orbea-contact-title">
          <div class="orbea-contact-copy">
            <p class="orbea-section-kicker">NIKASS / ПОДДЕРЖКА</p>
            <h2 id="orbea-contact-title">Остались вопросы?</h2>
            <p>Позвоните нам или напишите в мессенджере — ответим на вопросы и поможем подобрать оборудование под Вашу задачу.</p>
          </div>
          <div class="orbea-contact-actions" role="group" aria-label="Связаться с NIKASS">
            <a class="orbea-contact-pill" href="mailto:shop@nikass.ru">shop@nikass.ru</a>
            <a class="orbea-contact-pill" href="tel:+79256425315">+7 (925) 642-53-15</a>
            <a class="orbea-contact-icon orbea-contact-telegram" href="https://t.me/Nikass_energy" target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21.9 2.2c.3-.1.6.2.6.5l-3.2 17.1c-.1.6-.8.9-1.3.5l-5.1-3.8-2.8 2.7c-.4.4-1.1.2-1.1-.4l.2-4.7L18 6.5c.3-.3 0-.7-.4-.5L6.4 13.1l-4.6-1.4c-.6-.2-.6-1 .1-1.2l20-8.3Z" /></svg>
            </a>
            <button class="orbea-contact-icon orbea-contact-chat" type="button" data-chat-open aria-controls="nikass-chat-widget" aria-expanded="false" aria-label="Открыть консультанта NIKASS">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H12l-4 3v-3.1a2.5 2.5 0 0 1-3-2.4v-6Z" /><path d="M8 9h8M8 12h5" /></svg>
            </button>
          </div>
        </section>
        </main>

      <footer class="orbea-footer" id="footer">
        <div class="orbea-newsletter">
          <h3>О NIKASS</h3>
          <p>Автономная энергия для дома, дороги и работы.</p>
          <p>ИП Копаница Александр Викторович<br />ИНН 402809602074<br />ОГРНИП 311774617200097</p>
          <a href="/#contacts">Связаться с нами</a>
          <nav class="orbea-footer-legal-group" id="footer-documents" aria-label="Правовая информация">
            <h3>Правовая информация</h3>
            <ul>
              <li><a href="/privacy-policy">Политика конфиденциальности</a></li>
              <li><a href="/personal-data-consent">Согласие на обработку персональных данных</a></li>
              <li><a href="/advertising-consent">Информация о рекламных сообщениях</a></li>
            </ul>
          </nav>
        </div>
        <div class="orbea-footer-links">
          {footerGroups.map((group) => <div><h3>{group.title}</h3><ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}
        </div>
        <div class="orbea-legal"><span>© 2026 NIKASS. Россия</span></div>
      </footer>

    </div>

    <CookieNotice />

    <StoreChat />

    <script is:inline>
      const heroCarousel = document.querySelector("[data-hero-carousel]");
      if (heroCarousel) {
        const heroItems = [...heroCarousel.querySelectorAll("[data-hero-product]")];
        const heroViewport = heroCarousel.querySelector("[data-hero-viewport]");
        const heroStatus = heroCarousel.querySelector("[data-hero-status]");
        const heroCurrentCategory = heroCarousel.querySelector("[data-hero-current-category]");
        let heroIndex = heroItems.findIndex((item) => item.dataset.heroPosition === "0");
        let heroPointerStart;
        let suppressHeroClick = false;
        let heroAutoFrame;
        let heroAutoTimer;

        const cancelHeroAutoAdvance = () => {
          if (heroAutoFrame !== undefined) cancelAnimationFrame(heroAutoFrame);
          if (heroAutoTimer !== undefined) clearTimeout(heroAutoTimer);
          heroAutoFrame = undefined;
          heroAutoTimer = undefined;
          heroCarousel.classList.remove("is-hero-auto-hint");
        };
        const scheduleHeroAutoAdvance = (delay) => {
          heroAutoFrame = requestAnimationFrame(() => {
            heroAutoFrame = undefined;
            heroAutoTimer = setTimeout(() => {
              heroAutoTimer = undefined;
              heroCarousel.classList.add("is-hero-auto-hint");
            }, delay);
          });
        };

        const updateHero = (nextIndex) => {
          heroIndex = (nextIndex + heroItems.length) % heroItems.length;
          heroItems.forEach((item, index) => {
            let position = index - heroIndex;
            if (position > heroItems.length / 2) position -= heroItems.length;
            if (position < -heroItems.length / 2) position += heroItems.length;
            const active = position === 0;
            const visible = Math.abs(position) <= 1;
            item.dataset.heroPosition = String(position);
            item.setAttribute("aria-label", `${active ? "Открыть" : "Показать"} ${item.dataset.productName}`);
            item.toggleAttribute("aria-current", active);
            item.toggleAttribute("aria-hidden", !visible);
            item.tabIndex = visible ? 0 : -1;
          });
          heroStatus.textContent = `${heroItems[heroIndex].dataset.productName}, ${heroIndex + 1} из ${heroItems.length}`;
          if (heroCurrentCategory) heroCurrentCategory.textContent = heroItems[heroIndex].dataset.productName;
        };

        const finishHeroAutoAdvance = (event) => {
          if (event.animationName !== "orbea-hero-auto-nudge") return;
          cancelHeroAutoAdvance();
          updateHero(heroIndex + 1);
          scheduleHeroAutoAdvance(4000);
        };
        heroCarousel.addEventListener("animationend", finishHeroAutoAdvance);
        heroCarousel.querySelector("[data-hero-previous]").addEventListener("click", () => { cancelHeroAutoAdvance(); updateHero(heroIndex - 1); });
        heroCarousel.querySelector("[data-hero-next]").addEventListener("click", () => { cancelHeroAutoAdvance(); updateHero(heroIndex + 1); });
        heroItems.forEach((item, index) => item.addEventListener("click", (event) => {
          cancelHeroAutoAdvance();
          if (suppressHeroClick || index !== heroIndex) {
            event.preventDefault();
            if (!suppressHeroClick) updateHero(index);
          }
        }));
        heroCarousel.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          cancelHeroAutoAdvance();
          updateHero(heroIndex + (event.key === "ArrowRight" ? 1 : -1));
        });
        heroViewport.addEventListener("pointerdown", (event) => {
          cancelHeroAutoAdvance();
          if (event.pointerType !== "mouse") heroPointerStart = event.clientX;
        });
        heroViewport.addEventListener("pointerup", (event) => {
          if (heroPointerStart === undefined || Math.abs(event.clientX - heroPointerStart) < 40) return;
          suppressHeroClick = true;
          updateHero(heroIndex + (event.clientX < heroPointerStart ? 1 : -1));
          heroPointerStart = undefined;
          setTimeout(() => { suppressHeroClick = false; });
        });
        heroViewport.addEventListener("pointercancel", () => { heroPointerStart = undefined; });

        if (heroItems.length > 1 && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
          scheduleHeroAutoAdvance(2000);
          addEventListener("pagehide", cancelHeroAutoAdvance, { once: true });
        }
      }

      const bestsellersViewport = document.querySelector("[data-bestsellers-viewport]");
      if (bestsellersViewport) {
        const scrollBestsellers = (direction) => bestsellersViewport.scrollBy({ left: direction * bestsellersViewport.clientWidth * 0.72, behavior: "smooth" });
        document.querySelector("[data-bestsellers-previous]")?.addEventListener("click", () => scrollBestsellers(-1));
        document.querySelector("[data-bestsellers-next]")?.addEventListener("click", () => scrollBestsellers(1));
      }

    </script>
    <script>
      import { getCartCount, readCart, subscribeToCart } from "../lib/cart";
      const updateCart = () => document.querySelectorAll("[data-cart-count]").forEach((node) => { node.textContent = String(getCartCount(readCart().items)); });
      subscribeToCart(updateCart);
      updateCart();
    </script>
  </body>
</html>
