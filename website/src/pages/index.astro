---
import "../styles/global.css";
import ReviewsSection from "../components/ReviewsSection.astro";
import MessageScrollerDemo from "../components/MessageScrollerDemo";
import { formatPrice, loadCatalogProducts } from "../data/catalog";
import { directionEntries, storyEntries } from "../data/blog";

const apiBase = (import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000").replace(/\/$/, "");
const products = await loadCatalogProducts();

const bikes = [
  { id: "stations", category: "Зарядные станции", title: "Зарядные станции", body: "Энергия в пути", cta: "Смотреть решения", image: "wild-tr.webp" },
  { id: "inverters", category: "Инверторы", title: "Инверторы", body: "Стабильное питание", cta: "Выбрать инвертор", image: "oiz.webp" },
  { id: "panels", category: "Солнечные панели", title: "Солнечные панели", body: "Зарядка от солнца", cta: "Выбрать панель", image: "carpe.webp" },
  { id: "batteries", category: "Аккумуляторы", title: "AGM-аккумуляторы", body: "Запас автономности", cta: "Выбрать аккумулятор", image: "orca-aero.webp" },
];

const directions = directionEntries;
const stories = storyEntries;

const footerGroups = [
  { title: "Магазин", links: [{ label: "Каталог", href: "/catalog" }, { label: "Блог", href: "/blog" }, { label: "Корзина", href: "/cart" }] },
  { title: "Поддержка", links: [{ label: "Написать нам", href: "mailto:hello@nikass.ru" }] },
];

const bestSellers = products.slice(0, 4);
const heroProducts = [
  { article: "3541653896", heroImage: "/products_clean/3541653896/product.webp" },
  { article: "1755808721", heroImage: "/products_clean/1755808721/product.webp" },
  { article: "3204445652", heroImage: "/products_clean/3204445652/product.webp" },
  { article: "1755717935", heroImage: "/products_clean/1755717935/product.webp" },
  { article: "2132347841", heroImage: "/products_clean/2132347841/product.webp" },
].map(({ article, heroImage }) => {
  const product = products.find((item) => item.sku === article);
  if (!product) throw new Error(`Hero product ${article} is missing from the catalog`);
  return { ...product, heroImage };
});
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="NIKASS — автономная энергия для дома, дороги и работы." />
    <link rel="icon" href="/favicon.ico" />
    <title>NIKASS | Автономная энергия</title>
  </head>
  <body>
    <div class="orbea-page">
      <header class="orbea-header orbea-header-light" data-header>
        <a class="skip-link" href="#main-content">К содержимому</a>
        <div class="orbea-header-inner">
          <button class="orbea-mobile-menu-button" type="button" aria-label="Открыть меню" data-open-menu>
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 17h16" /></svg>
          </button>
          <nav class="orbea-desktop-nav" aria-label="Основная навигация">
            <button type="button" data-open-menu="Bikes">Товары</button>
            <button type="button" data-open-menu="Gear">Каталог</button>
            <a href="/blog">Блог</a>
            <a href="#custom">Как выбрать</a>
            <button type="button" data-open-menu="Commitment">О NIKASS</button>
          </nav>
          <a class="orbea-logo" href="/" aria-label="NIKASS — главная"><span class="orbea-wordmark">NIKASS</span></a>
          <div class="orbea-actions">
            <button class="orbea-icon-button" type="button" aria-label="Поиск" data-search-open>
              <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
            </button>
            <a class="orbea-icon-button" href="/cart" aria-label="Корзина">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 8h12l1 13H5L6 8Z" /><path d="M9 8V5a3 3 0 0 1 6 0v3" /></svg>
              <span class="orbea-cart-count" data-cart-count>0</span>
            </a>
          </div>
        </div>
        <div class="orbea-search-panel" hidden data-search-panel>
          <label for="orbea-search">Найти товар</label>
          <form action="/catalog"><input id="orbea-search" name="q" type="search" placeholder="Название или артикул" /><button type="submit">Найти</button><button type="button" aria-label="Закрыть поиск" data-search-close>×</button></form>
        </div>
      </header>

      <div class="orbea-menu-backdrop" hidden data-menu-backdrop>
        <aside class="orbea-menu-panel" role="dialog" aria-modal="true" aria-label="Навигация NIKASS">
          <div class="orbea-menu-header">
            <button class="orbea-menu-back" type="button" hidden data-menu-back>← <span>Назад</span></button>
            <strong class="orbea-menu-title">NIKASS</strong>
            <button class="orbea-icon-button" type="button" aria-label="Закрыть" data-menu-close>×</button>
          </div>
          <div class="orbea-menu-root" data-menu-root>
            <button class="orbea-menu-root-link" type="button" data-menu-section="Bikes">Товары <span>›</span></button>
            <button class="orbea-menu-root-link" type="button" data-menu-section="Gear">Каталог <span>›</span></button>
            <a class="orbea-menu-root-link" href="/blog" data-menu-anchor>Блог</a>
            <a class="orbea-menu-root-link" href="#custom" data-menu-anchor>Как выбрать</a>
            <button class="orbea-menu-root-link" type="button" data-menu-section="Commitment">О NIKASS <span>›</span></button>
          </div>
          <div class="orbea-menu-detail" hidden data-menu-detail>
            <div class="orbea-menu-list" data-menu-list></div>
            <div class="orbea-menu-promo" hidden data-menu-promo>
              <img src="/assets/images/gear-menu.webp" alt="Оборудование NIKASS" />
              <div><span>Система, а не отдельные детали.</span><strong>Соберите своё решение</strong><a href="/catalog" data-menu-anchor>Открыть каталог</a></div>
            </div>
          </div>
        </aside>
      </div>

      <main id="main-content">
        <section class="orbea-hero orbea-hero-featured">
          <div class="orbea-hero-copy">
            <h1>Энергия без привязки</h1>
            <p>Надёжные решения для дома, дороги и работы — там, где нужна свобода от розетки.</p>
            <div class="orbea-hero-actions">
              <a class="orbea-button" href="/catalog"><span>↗</span> Смотреть каталог</a>
              <a class="orbea-button orbea-button-dark" href="#custom">Подобрать решение</a>
            </div>
          </div>
          <div class="orbea-hero-products" role="region" aria-roledescription="карусель" aria-label="Рекомендуемые товары" data-hero-carousel>
            <button class="orbea-hero-arrow orbea-hero-arrow-previous" type="button" aria-label="Предыдущий товар" aria-controls="hero-products-viewport" data-hero-previous>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6" /></svg>
            </button>
            <div class="orbea-hero-products-viewport" id="hero-products-viewport" data-hero-viewport>
            {heroProducts.map((product, index) => (
              <a
                class="orbea-hero-product-card"
                href={`/catalog/${product.slug}`}
                aria-label={`${index === 2 ? "Открыть" : "Показать"} ${product.name}`}
                aria-current={index === 2 ? "true" : undefined}
                aria-hidden={Math.abs(index - 2) > 1 ? "true" : undefined}
                tabindex={Math.abs(index - 2) > 1 ? -1 : undefined}
                data-hero-product
                data-product-name={product.name}
                data-hero-position={index - 2}
              >
                <span class="orbea-hero-product-media"><img src={product.heroImage} alt={product.name} loading={index === 2 ? "eager" : "lazy"} decoding="async" /></span>
                <span class="orbea-hero-product-name">{product.name}</span>
              </a>
            ))}
            </div>
            <button class="orbea-hero-arrow orbea-hero-arrow-next" type="button" aria-label="Следующий товар" aria-controls="hero-products-viewport" data-hero-next>
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6" /></svg>
            </button>
            <span class="sr-only" aria-live="polite" data-hero-status>{heroProducts[2].name}, 3 из {heroProducts.length}</span>
          </div>
        </section>

        <section class="orbea-bestsellers" id="bestsellers">
          <div class="orbea-bestsellers-intro">
            <div>
              <p class="orbea-section-kicker">NIKASS / ВЫБОР ПОКУПАТЕЛЕЙ</p>
              <h2>Хиты продаж</h2>
            </div>
            <a class="orbea-button orbea-button-dark" href="/catalog">Смотреть весь каталог</a>
          </div>
          <div class="orbea-bestsellers-grid">
            {bestSellers.map((product) => (
              <a class="orbea-bestseller-card" href={`/catalog/${product.slug}`}>
                <div class="orbea-bestseller-image"><img src={product.image} alt={product.name} loading="lazy" /></div>
                <div class="orbea-bestseller-copy">
                  <p>{product.category}</p>
                  <h3>{product.name}</h3>
                  <div><strong>{formatPrice(product.price)}</strong>{product.oldPrice && <del>{formatPrice(product.oldPrice)}</del>}</div>
                </div>
              </a>
            ))}
          </div>
        </section>

        <section class="orbea-section-intro"><h2>Выберите свой источник энергии</h2></section>
        <section class="orbea-bike-grid">
          {bikes.map((bike) => (
            <article class="orbea-bike-card" id={bike.id}>
              <img src={`/assets/images/${bike.image}`} alt="" />
              <div class="orbea-bike-shade"></div>
              <div class="orbea-bike-copy"><h3>{bike.title}</h3><strong>{bike.body}</strong><a class="orbea-button" href={`/catalog?category=${encodeURIComponent(bike.category)}`}>{bike.cta}</a></div>
            </article>
          ))}
        </section>

        <section class="orbea-video-section orbea-custom-video" id="custom">
          <video class="orbea-video orbea-video-desktop" autoplay loop muted playsinline><source src="/assets/videos/custom-desktop.webm" type="video/webm" /></video>
          <video class="orbea-video orbea-video-mobile" autoplay loop muted playsinline><source src="/assets/videos/custom-mobile.webm" type="video/webm" /></video>
          <div class="orbea-video-overlay"></div>
          <div class="orbea-video-copy">
            <h2>Соберите свою систему автономности</h2>
            <p>Выберите станцию, панель и аккумулятор под свой сценарий — для спокойствия дома, поездок и рабочих задач.</p>
            <div class="orbea-video-actions">
              <a class="orbea-button" href="/catalog">Перейти в каталог</a>
              <button class="orbea-button" type="button" aria-controls="nikass-chat-widget" aria-expanded="false" data-chat-open>Получить консультацию</button>
            </div>
          </div>
        </section>

        <section class="orbea-section-intro orbea-directions-intro"><h2>Что нужно именно вам?</h2></section>
        <section class="orbea-directions">
          <div class="orbea-directions-viewport">
            <div class="orbea-directions-track" data-directions-track>
              {directions.map((direction) => (
                <a class="orbea-direction-card" id={direction.slug} href={`/blog/${direction.slug}`} aria-label={`Открыть статью: ${direction.title}`}>
                  <picture><img src={`/assets/images/${direction.image}`} alt="" /></picture>
                  <div class="orbea-direction-shade"></div>
                  <div class="orbea-direction-copy"><h3>{direction.title}: {direction.body}</h3><span class="orbea-button">Читать статью ↗</span></div>
                </a>
              ))}
            </div>
          </div>
        </section>

        <section class="orbea-stories" id="stories">
          <div class="orbea-stories-intro">
            <h2>Практика автономной жизни</h2>
            <p>Разбираем реальные сценарии: как пережить отключение, зарядить технику в дороге и собрать систему под свои задачи.</p>
            <a class="orbea-button orbea-button-dark" href="/blog"><span>↗</span> Все статьи</a>
          </div>
          <div class="orbea-story-row" role="region" aria-label="Статьи блога" tabindex="0">
            {stories.map((story) => (
              <a class="orbea-story-card" href={`/blog/${story.slug}`} aria-label={`Открыть статью: ${story.title}`} style={`background-image:url('/assets/images/${story.image}')`}>
                <div class="orbea-story-shade"></div>
                <div class="orbea-story-meta"><span>{story.date}</span>{story.tag && <span>{story.tag}</span>}</div>
                <h3>{story.title}</h3>
              </a>
            ))}
          </div>
        </section>
        <ReviewsSection />
        <section class="orbea-contact-cta" id="contacts" aria-labelledby="orbea-contact-title">
          <div class="orbea-contact-copy">
            <p class="orbea-section-kicker">NIKASS / ПОДДЕРЖКА</p>
            <h2 id="orbea-contact-title">Остались вопросы?</h2>
            <p>Позвоните нам или напишите в мессенджере — ответим на вопросы и поможем подобрать оборудование под Вашу задачу.</p>
          </div>
          <div class="orbea-contact-actions" role="group" aria-label="Связаться с NIKASS">
            <a class="orbea-contact-pill" href="mailto:hello@nikass.ru">hello@nikass.ru</a>
            <button class="orbea-contact-pill" type="button" data-chat-open aria-controls="nikass-chat-widget" aria-expanded="false">Получить консультацию</button>
            <button class="orbea-contact-icon" type="button" data-chat-open aria-controls="nikass-chat-widget" aria-expanded="false" aria-label="Открыть консультанта NIKASS">
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H12l-4 3v-3.1a2.5 2.5 0 0 1-3-2.4v-6Z" /><path d="M8 9h8M8 12h5" /></svg>
            </button>
          </div>
        </section>
        </main>

      <footer class="orbea-footer" id="footer">
        <div class="orbea-newsletter">
          <h3>О NIKASS</h3>
          <p>Автономная энергия для дома, дороги и работы.</p>
          <a href="mailto:hello@nikass.ru">Связаться с нами</a>
        </div>
        <div class="orbea-footer-links">
          {footerGroups.map((group) => <div><h3>{group.title}</h3><ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul></div>)}
        </div>
        <div class="orbea-footer-bottom">
          <div class="orbea-footer-location"><span>◎ Россия</span></div>
          <a class="orbea-kide" href="/catalog">Каталог NIKASS</a>
        </div>
        <div class="orbea-legal"><span>© 2026 NIKASS. Россия</span></div>
      </footer>

      <button class="orbea-pause-button" type="button" aria-label="Поставить видео на паузу" data-video-toggle>Ⅱ</button>
    </div>

    <aside id="nikass-chat-widget" class="orbea-chat-widget" hidden data-chat-widget role="dialog" aria-modal="true" aria-label="Консультант NIKASS">
      <button class="orbea-chat-widget-close" type="button" aria-label="Закрыть консультанта" data-chat-close>×</button>
      <MessageScrollerDemo apiBase={apiBase} client:load />
    </aside>

    <script is:inline>
      const header = document.querySelector("[data-header]");
      const menuBackdrop = document.querySelector("[data-menu-backdrop]");
      const menuPanel = menuBackdrop.querySelector(".orbea-menu-panel");
      const menuRoot = document.querySelector("[data-menu-root]");
      const menuDetail = document.querySelector("[data-menu-detail]");
      const menuList = document.querySelector("[data-menu-list]");
      const menuPromo = document.querySelector("[data-menu-promo]");
      const menuBack = document.querySelector("[data-menu-back]");
      const menuTitle = document.querySelector(".orbea-menu-title");
      const menuClose = document.querySelector("[data-menu-close]");
      const mobileMenuButton = document.querySelector(".orbea-mobile-menu-button");
      const page = document.querySelector(".orbea-page");
      const searchPanel = document.querySelector("[data-search-panel]");
      const searchInput = document.querySelector("#orbea-search");
      const searchOpenButton = document.querySelector("[data-search-open]");
      const chatWidget = document.querySelector("[data-chat-widget]");
      const chatClose = chatWidget?.querySelector("[data-chat-close]");
      const chatOpenButtons = [...document.querySelectorAll("[data-chat-open]")];
      let lastMenuTrigger;
      let lastSearchTrigger;
      let lastChatTrigger;

      const menuData = {
        Bikes: ["Зарядные станции", "Инверторы", "Солнечные панели", "Аккумуляторы"],
        Gear: ["Зарядные станции", "Инверторы", "Солнечные панели", "Аккумуляторы"],
        Commitment: ["О компании", "Поддержка"],
      };
      const menuLabels = { Bikes: "Товары", Gear: "Каталог", Commitment: "О NIKASS" };

      const syncOverflow = () => { document.body.style.overflow = !menuBackdrop.hidden || !searchPanel.hidden ? "hidden" : ""; };
      const showMenuRoot = () => {
        menuTitle.textContent = "NIKASS";
        menuBack.hidden = true;
        menuRoot.hidden = false;
        menuDetail.hidden = true;
      };
      const showMenuSection = (section) => {
        menuTitle.textContent = menuLabels[section] || section;
        menuBack.hidden = false;
        menuRoot.hidden = true;
        menuDetail.hidden = false;
        menuPromo.hidden = section !== "Gear";
        menuList.innerHTML = menuData[section].map((item) => `<a class="orbea-menu-detail-link" href="${section === "Commitment" ? "/#footer" : `/catalog?category=${encodeURIComponent(item)}`}" data-menu-anchor><span>${item}</span><span>›</span></a>`).join("");
        menuList.querySelectorAll("[data-menu-anchor]").forEach((link) => link.addEventListener("click", closeMenu));
      };
      const openMenu = (section) => {
        lastMenuTrigger = document.activeElement;
        menuBackdrop.hidden = false;
        [...document.querySelectorAll(".orbea-page > :not(.orbea-menu-backdrop)")].forEach((element) => { element.inert = true; });
        mobileMenuButton.setAttribute("aria-label", "Закрыть меню");
        section ? showMenuSection(section) : showMenuRoot();
        syncOverflow();
        requestAnimationFrame(() => menuClose.focus());
      };
      const closeMenu = () => {
        if (menuBackdrop.hidden) return;
        menuBackdrop.hidden = true;
        [...document.querySelectorAll(".orbea-page > :not(.orbea-menu-backdrop)")].forEach((element) => { element.inert = false; });
        mobileMenuButton.setAttribute("aria-label", "Открыть меню");
        showMenuRoot(); syncOverflow();
        if (lastMenuTrigger instanceof HTMLElement) lastMenuTrigger.focus();
      };

      const setChatOpen = (open) => {
        if (!chatWidget) return;
        chatWidget.hidden = !open;
        page.inert = open;
        chatOpenButtons.forEach((button) => button.setAttribute("aria-expanded", String(open)));
        if (open) {
          lastChatTrigger = document.activeElement;
          requestAnimationFrame(() => chatClose?.focus());
        } else if (lastChatTrigger instanceof HTMLElement) {
          lastChatTrigger.focus();
        }
      };
      chatOpenButtons.forEach((button) => button.addEventListener("click", () => setChatOpen(true)));
      chatClose?.addEventListener("click", () => setChatOpen(false));

      document.querySelectorAll("[data-open-menu]").forEach((button) => button.addEventListener("click", () => openMenu(button.dataset.openMenu || "")));
      document.querySelectorAll("[data-menu-section]").forEach((button) => button.addEventListener("click", () => showMenuSection(button.dataset.menuSection)));
      document.querySelectorAll("[data-menu-anchor]").forEach((link) => link.addEventListener("click", closeMenu));
      menuClose.addEventListener("click", closeMenu);
      menuBack.addEventListener("click", showMenuRoot);
      menuBackdrop.addEventListener("click", closeMenu);
      menuPanel.addEventListener("click", (event) => event.stopPropagation());

      const closeSearch = () => {
        if (searchPanel.hidden) return;
        searchPanel.hidden = true;
        syncOverflow();
        if (lastSearchTrigger instanceof HTMLElement) lastSearchTrigger.focus();
      };
      searchOpenButton.addEventListener("click", () => {
        if (!searchPanel.hidden) return closeSearch();
        lastSearchTrigger = document.activeElement;
        searchPanel.hidden = false;
        syncOverflow();
        searchInput.focus();
      });
      document.querySelector("[data-search-close]").addEventListener("click", closeSearch);
      const trapFocus = (event, container) => {
        const focusable = [...container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled])')].filter((element) => element.offsetParent !== null);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
      };
      document.addEventListener("keydown", (event) => {
        if (event.key === "Tab") {
          if (!chatWidget?.hidden) trapFocus(event, chatWidget);
          else if (!menuBackdrop.hidden) trapFocus(event, menuPanel);
        }
        if (event.key === "Escape") { setChatOpen(false); closeMenu(); closeSearch(); }
      });
      const updateHeader = () => header.classList.toggle("is-scrolled", scrollY > 24);
      addEventListener("scroll", updateHeader, { passive: true });
      updateHeader();

      const heroCarousel = document.querySelector("[data-hero-carousel]");
      if (heroCarousel) {
        const heroItems = [...heroCarousel.querySelectorAll("[data-hero-product]")];
        const heroViewport = heroCarousel.querySelector("[data-hero-viewport]");
        const heroStatus = heroCarousel.querySelector("[data-hero-status]");
        let heroIndex = heroItems.findIndex((item) => item.dataset.heroPosition === "0");
        let heroPointerStart;
        let suppressHeroClick = false;

        const updateHero = (nextIndex) => {
          heroIndex = (nextIndex + heroItems.length) % heroItems.length;
          heroItems.forEach((item, index) => {
            let position = index - heroIndex;
            if (position > heroItems.length / 2) position -= heroItems.length;
            if (position < -heroItems.length / 2) position += heroItems.length;
            const active = position === 0;
            const visible = Math.abs(position) <= 1;
            item.dataset.heroPosition = String(position);
            item.setAttribute("aria-label", `${active ? "Открыть" : "Показать"} ${item.dataset.productName}`);
            item.toggleAttribute("aria-current", active);
            item.toggleAttribute("aria-hidden", !visible);
            item.tabIndex = visible ? 0 : -1;
          });
          heroStatus.textContent = `${heroItems[heroIndex].dataset.productName}, ${heroIndex + 1} из ${heroItems.length}`;
        };

        heroCarousel.querySelector("[data-hero-previous]").addEventListener("click", () => updateHero(heroIndex - 1));
        heroCarousel.querySelector("[data-hero-next]").addEventListener("click", () => updateHero(heroIndex + 1));
        heroItems.forEach((item, index) => item.addEventListener("click", (event) => {
          if (suppressHeroClick || index !== heroIndex) {
            event.preventDefault();
            if (!suppressHeroClick) updateHero(index);
          }
        }));
        heroCarousel.addEventListener("keydown", (event) => {
          if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
          event.preventDefault();
          updateHero(heroIndex + (event.key === "ArrowRight" ? 1 : -1));
        });
        heroViewport.addEventListener("pointerdown", (event) => {
          if (event.pointerType !== "mouse") heroPointerStart = event.clientX;
        });
        heroViewport.addEventListener("pointerup", (event) => {
          if (heroPointerStart === undefined || Math.abs(event.clientX - heroPointerStart) < 40) return;
          suppressHeroClick = true;
          updateHero(heroIndex + (event.clientX < heroPointerStart ? 1 : -1));
          heroPointerStart = undefined;
          setTimeout(() => { suppressHeroClick = false; });
        });
        heroViewport.addEventListener("pointercancel", () => { heroPointerStart = undefined; });
      }

      let paused = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const videoToggle = document.querySelector("[data-video-toggle]");
      const syncVideos = () => {
        document.querySelectorAll("video").forEach((video) => paused ? video.pause() : video.play().catch(() => {}));
        videoToggle.textContent = paused ? "▶" : "Ⅱ";
        videoToggle.setAttribute("aria-label", paused ? "Включить видео" : "Поставить видео на паузу");
      };
      videoToggle.addEventListener("click", () => { paused = !paused; syncVideos(); });
      syncVideos();
    </script>
    <script>
      import { getCartCount, readCart, subscribeToCart } from "../lib/cart";
      const updateCart = () => document.querySelectorAll("[data-cart-count]").forEach((node) => { node.textContent = String(getCartCount(readCart().items)); });
      subscribeToCart(updateCart);
      updateCart();
    </script>
  </body>
</html>
