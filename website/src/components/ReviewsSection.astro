---
import { reviews } from "../data/reviews";
---

<section class="reviews-standalone" id="reviews" aria-label="Отзывы клиентов">
	<div class="reviews-intro">
		<div class="reviews-copy">
			<h2>Нас выбирают.<br />Нас рекомендуют.</h2>
			<p class="reviews-description">Тысячи клиентов делятся своими впечатлениями о наших решениях. Мы ценим каждое мнение — оно помогает нам становиться лучше.</p>
		</div>
		<aside class="reviews-summary" aria-label="Средняя оценка отзывов">
			<div class="reviews-score">
				<span class="reviews-score-value"><strong>4,8</strong><span>/ 5</span></span>
				<span class="reviews-summary-count">7 779 отзывов</span>
			</div>
			<span class="reviews-summary-stars" aria-label="5 из 5 звёзд">★★★★★</span>
		</aside>
	</div>
	<div class="reviews-marquee" data-reviews-scroll>
		{[...reviews, ...reviews].map((review) => (
			<article class="review-card">
				<details name="reviews">
					<summary>
						<span class="review-topline"><strong>{review.rating}</strong></span>
						<span class="review-name">{review.name}</span>
						<span class="review-preview">{review.text}</span>
						<span class="review-action" aria-hidden="true"></span>
					</summary>
					<p class="review-full">{review.text}</p>
				</details>
			</article>
		))}
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-reviews-scroll]").forEach((scroller) => {
		let pressed = false;
		let dragging = false;
		let touching = false;
		let suppressClickUntil = 0;
		let startX = 0;
		let startLeft = 0;
		let position = scroller.scrollLeft;
		let previousFrame = performance.now();
		let resumeTimer = 0;

		const animate = (now: number) => {
			const elapsed = Math.min(now - previousFrame, 50);
			previousFrame = now;
			if (dragging || touching || scroller.querySelector("details[open]")) {
				position = scroller.scrollLeft;
				requestAnimationFrame(animate);
				return;
			}
			const halfway = scroller.scrollWidth / 2;
			position = position >= halfway ? position - halfway : position + elapsed * 0.036;
			scroller.scrollLeft = position;
			requestAnimationFrame(animate);
		};
		requestAnimationFrame(animate);

		const pauseTouch = () => {
			touching = true;
			window.clearTimeout(resumeTimer);
		};
		const resumeTouch = () => {
			window.clearTimeout(resumeTimer);
			resumeTimer = window.setTimeout(() => { touching = false; }, 1800);
		};
		scroller.addEventListener("touchstart", pauseTouch, { passive: true });
		scroller.addEventListener("touchend", resumeTouch, { passive: true });
		scroller.addEventListener("touchcancel", resumeTouch, { passive: true });

		scroller.addEventListener("pointerdown", (event) => {
			if (event.pointerType !== "mouse") return;
			pressed = true;
			startX = event.clientX;
			startLeft = scroller.scrollLeft;
		});

		scroller.addEventListener("pointermove", (event) => {
			if (event.pointerType !== "mouse" || !pressed) return;
			const distance = event.clientX - startX;
			if (!dragging && Math.abs(distance) < 6) return;
			if (!dragging) {
				dragging = true;
				scroller.classList.add("dragging");
				scroller.setPointerCapture(event.pointerId);
			}
			scroller.scrollLeft = startLeft - distance;
		});

		const stop = () => {
			if (dragging) suppressClickUntil = performance.now() + 100;
			pressed = false;
			dragging = false;
			scroller.classList.remove("dragging");
		};

		scroller.addEventListener("click", (event) => {
			if (performance.now() >= suppressClickUntil) return;
			event.preventDefault();
			event.stopPropagation();
		});
		scroller.addEventListener("pointerup", stop);
		scroller.addEventListener("pointercancel", stop);
	});
</script>

<style>
	.reviews-standalone {
		background: #f3f3f3;
		color: #171916;
		font-family: inherit;
		line-height: normal;
		width: 100%;
		padding: 28px 0 48px;
		overflow: hidden;
	}

	.reviews-standalone h2 {
		width: auto;
		margin: 0;
		padding-inline: 64px;
		color: #333131;
		font-size: 32px;
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -.02em;
	}

	.reviews-intro {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(320px, .75fr);
		align-items: start;
		gap: 48px;
		width: min(calc(100% - 40px), 1400px);
		margin: 0 auto;
	}

	.reviews-copy { max-width: 680px; }
	.reviews-intro h2 {
		margin: 0;
		padding: 0;
		color: #192330;
		font-size: clamp(36px, 4.2vw, 54px);
		font-weight: 500;
		line-height: .99;
		letter-spacing: -.045em;
	}
	.reviews-description {
		max-width: 620px;
		margin: 24px 0 0;
		color: #718092;
		font-size: 20px;
		line-height: 1.4;
	}

	.reviews-summary {
		justify-self: end;
		box-sizing: border-box;
		width: min(100%, 405px);
		min-height: 0;
		padding: 24px 30px;
		border: 1px solid #e0e5ed;
		border-radius: 16px;
		background: rgba(255, 255, 255, .82);
		box-shadow: 0 8px 26px rgba(31, 51, 75, .04);
	}
	.reviews-score { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
	.reviews-score-value { display: flex; align-items: baseline; gap: 16px; flex: 0 0 auto; }
	.reviews-score strong {
		color: #17222e;
		font-size: 76px;
		font-weight: 500;
		letter-spacing: -.05em;
		line-height: 1;
	}
	.reviews-score-value > span { color: #7f8c9b; font-size: 45px; line-height: 1; }
	.reviews-summary-stars {
		display: block;
		margin-top: 12px;
		color: #f8bd3f;
		font-size: 35px;
		letter-spacing: 2px;
		line-height: 1;
		white-space: nowrap;
	}
	.reviews-summary-count { color: #8492a0; font-size: 20px; white-space: nowrap; }

	.reviews-marquee {
		display: flex;
		align-items: flex-start;
		gap: 16px;
		margin-top: 34px;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		padding: 0 30px 8px;
		scrollbar-width: none;
		touch-action: auto;
		user-select: none;
		cursor: grab;
	}

	.reviews-marquee::-webkit-scrollbar { display: none; }
	.reviews-marquee.dragging { cursor: grabbing; }

	.review-card {
		flex: 0 0 calc((100vw - 108px) / 4);
		box-sizing: border-box;
		min-height: 168px;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.68);
		cursor: pointer;
		transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.review-card details { min-height: inherit; }
	.review-card summary {
		box-sizing: border-box;
		min-height: inherit;
		padding: 18px 20px;
		list-style: none;
	}
	.review-card summary::-webkit-details-marker { display: none; }
	.review-card:hover {
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 14px 32px rgba(38, 32, 27, 0.08);
		transform: scale(1.025);
	}

	.review-topline { display: flex; align-items: center; color: #6d6660; font-size: 14px; }
	.review-topline strong { color: #2e2b29; font-size: 16px; font-weight: 500; }
	.review-topline strong::before {
		margin-right: 8px;
		color: #888;
		font-size: 13px;
		letter-spacing: 1px;
		content: "★★★★★";
	}

	.review-name { display: block; margin: 18px 0 8px; font-size: 22px; font-weight: 400; }
	.review-preview {
		display: -webkit-box;
		overflow: hidden;
		color: #47413d;
		font-size: 15px;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.review-action { display: block; margin-top: 12px; color: #7a5f70; font-size: 13px; }
	.review-action::before { content: "Читать полностью ↓"; }
	.review-card details[open] .review-preview { display: none; }
	.review-card details[open] .review-action::before { content: "Свернуть ↑"; }
	.review-full { margin: 0; padding: 0 20px 18px; color: #47413d; font-size: 15px; line-height: 1.42; }

	@media (max-width: 900px) {
		.reviews-marquee { padding: 0 16px 8px; }
		.review-card { flex-basis: min(78vw, 320px); }
	}

	@media (max-width: 767px) {
		.reviews-standalone {
			padding: 24px 0 28px;
		}

		.reviews-marquee {
			gap: 12px;
			margin-top: 20px;
			scroll-padding-inline: 16px;
		}

		.review-card {
			flex-basis: min(82vw, 320px);
			scroll-snap-align: start;
		}
	}

	@media (max-width: 900px) {
		.reviews-intro {
			grid-template-columns: 1fr;
			gap: 24px;
		}
		.reviews-intro h2 { padding-inline: 0; }
		.reviews-summary {
			justify-self: stretch;
			width: auto;
		}
	}

	@media (max-width: 520px) {
		.reviews-intro { width: min(calc(100% - 32px), 1400px); }
		.reviews-intro h2 { font-size: 34px; }
		.reviews-description { margin-top: 18px; font-size: 17px; }
		.reviews-summary { min-height: 0; padding: 20px 22px; }
		.reviews-score strong { font-size: 60px; }
		.reviews-score-value > span { font-size: 34px; }
		.reviews-summary-stars { margin-top: 10px; font-size: 29px; }
		.reviews-summary-count { font-size: 17px; }
	}
</style>
