</section>

<script>
	document.querySelectorAll<HTMLElement>("[data-reviews-scroll]").forEach((scroller) => {
		let pressed = false;
		let dragging = false;
		let touching = false;
		let suppressClickUntil = 0;
		let startX = 0;
		let startLeft = 0;
		let position = scroller.scrollLeft;
		let previousFrame = performance.now();
		let resumeTimer = 0;

		const animate = (now: number) => {
			const elapsed = Math.min(now - previousFrame, 50);
			previousFrame = now;
			if (dragging || touching || scroller.querySelector("details[open]")) {
				position = scroller.scrollLeft;
				requestAnimationFrame(animate);
				return;
			}
			const halfway = scroller.scrollWidth / 2;
			position = position >= halfway ? position - halfway : position + elapsed * 0.036;
			scroller.scrollLeft = position;
			requestAnimationFrame(animate);
		};
		requestAnimationFrame(animate);

		const pauseTouch = () => {
			touching = true;
			window.clearTimeout(resumeTimer);
		};
		const resumeTouch = () => {
			window.clearTimeout(resumeTimer);
			resumeTimer = window.setTimeout(() => { touching = false; }, 1800);
		};
		scroller.addEventListener("touchstart", pauseTouch, { passive: true });
		scroller.addEventListener("touchend", resumeTouch, { passive: true });
		scroller.addEventListener("touchcancel", resumeTouch, { passive: true });

		scroller.addEventListener("pointerdown", (event) => {
			if (event.pointerType !== "mouse") return;
			pressed = true;
			startX = event.clientX;
			startLeft = scroller.scrollLeft;
		});

		scroller.addEventListener("pointermove", (event) => {
			if (event.pointerType !== "mouse" || !pressed) return;
			const distance = event.clientX - startX;
			if (!dragging && Math.abs(distance) < 6) return;
			if (!dragging) {
				dragging = true;
				scroller.classList.add("dragging");
				scroller.setPointerCapture(event.pointerId);
			}
			scroller.scrollLeft = startLeft - distance;
		});

		const stop = () => {
			if (dragging) suppressClickUntil = performance.now() + 100;
			pressed = false;
			dragging = false;
			scroller.classList.remove("dragging");
		};

		scroller.addEventListener("click", (event) => {
			if (performance.now() >= suppressClickUntil) return;
			event.preventDefault();
			event.stopPropagation();
		});
		scroller.addEventListener("pointerup", stop);
		scroller.addEventListener("pointercancel", stop);
	});
</script>

<style>
	.reviews-standalone {
		background: #f3f3f3;
		color: #171916;
		font-family: inherit;
		line-height: normal;
		width: 100%;
		padding: 28px 0 48px;
		overflow: hidden;
	}

	.reviews-standalone h2 {
		width: auto;
		margin: 0;
		padding-inline: 64px;
		color: #333131;
		font-size: 32px;
		font-weight: 500;
		line-height: 1.1;
		letter-spacing: -.02em;
	}

	.reviews-trust {
		display: grid;
		grid-template-columns: minmax(310px, 1.65fr) auto auto minmax(310px, 1.2fr);
		gap: 16px;
		width: min(100% - 60px, 2000px);
		margin: 28px auto 0;
	}

	.reviews-trust > * {
		box-sizing: border-box;
		min-height: 92px;
		border: 1px solid rgba(255, 255, 255, 0.7);
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.68);
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
	}

	.reviews-trust__award,
	.reviews-trust__rating,
	.reviews-trust__count,
	.reviews-trust__link {
		display: flex;
		align-items: center;
	}

	.reviews-trust__award {
		gap: 14px;
		padding: 15px 20px;
	}

	.reviews-trust__award-mark {
		stroke: none;
		width: 54px;
		height: 54px;
		flex: 0 0 auto;
	}

	.award-laurels { fill: #ffb000; }
	.award-pin { fill: #ff5b2e; }

	.reviews-trust__award span {
		display: grid;
		gap: 5px;
	}

	.reviews-trust__award strong {
		color: #3285ee;
		font-size: 18px;
		font-weight: 500;
	}

	.reviews-trust__award small {
		color: #77716d;
		font-size: 13px;
	}

	.reviews-trust__rating {
		gap: 13px;
		padding: 0 24px;
		white-space: nowrap;
	}

	.reviews-trust__rating strong,
	.reviews-trust__count strong {
		color: #282522;
		font-size: 26px;
		font-weight: 400;
	}

	.reviews-trust__rating span {
		color: #888;
		font-size: 21px;
		letter-spacing: 1px;
	}

	.reviews-trust__count {
		gap: 6px;
		justify-content: center;
		padding: 0 24px;
		white-space: nowrap;
	}

	.reviews-trust__count span {
		color: #514b47;
		font-size: 18px;
	}

	.reviews-trust__link {
		justify-content: space-between;
		gap: 20px;
		padding: 0 28px;
		background: rgba(255, 255, 255, 0.68);
		color: #302b2e;
		text-decoration: none;
		font-size: 17px;
		transition: box-shadow 180ms ease, transform 140ms ease;
	}

	.reviews-trust__link:hover {
		box-shadow: 0 14px 32px rgba(82, 53, 69, 0.12);
		transform: translateY(-2px);
	}

	.reviews-trust__link:active { transform: scale(0.98); }

	.reviews-trust__link svg {
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.6;
	}

	.reviews-marquee {
		display: flex;
		align-items: flex-start;
		gap: 16px;
		margin-top: 34px;
		overflow-x: auto;
		overflow-y: hidden;
		overscroll-behavior-x: contain;
		-webkit-overflow-scrolling: touch;
		padding: 0 30px 8px;
		scrollbar-width: none;
		touch-action: auto;
		user-select: none;
		cursor: grab;
	}

	.reviews-marquee::-webkit-scrollbar { display: none; }
	.reviews-marquee.dragging { cursor: grabbing; }

	.review-card {
		flex: 0 0 calc((100vw - 108px) / 4);
		box-sizing: border-box;
		min-height: 168px;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.68);
		cursor: pointer;
		transition: background 180ms ease, box-shadow 180ms ease, transform 180ms ease;
	}

	.review-card details { min-height: inherit; }
	.review-card summary {
		box-sizing: border-box;
		min-height: inherit;
		padding: 18px 20px;
		list-style: none;
	}
	.review-card summary::-webkit-details-marker { display: none; }
	.review-card:hover {
		background: rgba(255, 255, 255, 0.82);
		box-shadow: 0 14px 32px rgba(38, 32, 27, 0.08);
		transform: scale(1.025);
	}

	.review-topline { display: flex; align-items: center; color: #6d6660; font-size: 14px; }
	.review-topline strong { color: #2e2b29; font-size: 16px; font-weight: 500; }
	.review-topline strong::before {
		margin-right: 8px;
		color: #888;
		font-size: 13px;
		letter-spacing: 1px;
		content: "★★★★★";
	}

	.review-name { display: block; margin: 18px 0 8px; font-size: 22px; font-weight: 400; }
	.review-preview {
		display: -webkit-box;
		overflow: hidden;
		color: #47413d;
		font-size: 15px;
		line-height: 1.42;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	.review-action { display: block; margin-top: 12px; color: #7a5f70; font-size: 13px; }
	.review-action::before { content: "Читать полностью ↓"; }
	.review-card details[open] .review-preview { display: none; }
	.review-card details[open] .review-action::before { content: "Свернуть ↑"; }
	.review-full { margin: 0; padding: 0 20px 18px; color: #47413d; font-size: 15px; line-height: 1.42; }

	@media (max-width: 900px) {
		.reviews-trust {
			grid-template-columns: 1fr 1fr;
			width: min(100% - 32px, 1198px);
		}
		.reviews-trust__award,
		.reviews-trust__link { grid-column: 1 / -1; }
		.reviews-marquee { padding: 0 16px 8px; }
		.review-card { flex-basis: min(78vw, 320px); }
	}

	@media (max-width: 520px) {
		.reviews-trust { gap: 10px; }
		.reviews-trust > * { min-height: 78px; border-radius: 15px; }
		.reviews-trust__award { padding: 12px 15px; }
		.reviews-trust__award-mark { width: 46px; height: 46px; }
		.reviews-trust__award strong { font-size: 16px; }
		.reviews-trust__award small { font-size: 12px; }
		.reviews-trust__rating,
		.reviews-trust__count { padding: 0 14px; }
		.reviews-trust__rating { gap: 8px; }
		.reviews-trust__rating strong,
		.reviews-trust__count strong { font-size: 22px; }
		.reviews-trust__rating span { font-size: 14px; letter-spacing: 0; }
		.reviews-trust__count span { font-size: 15px; }
		.reviews-trust__link { min-height: 82px; padding: 0 20px; font-size: 16px; }
	}

	@media (max-width: 767px) {
		.reviews-standalone {
			padding: 24px 0 28px;
		}

		.reviews-standalone h2 {
			padding-inline: 20px;
			font-size: 28px;
		}

		.reviews-marquee {
			gap: 12px;
			margin-top: 20px;
			scroll-padding-inline: 16px;
		}

		.review-card {
			flex-basis: min(82vw, 320px);
			scroll-snap-align: start;
		}
	}
</style>
