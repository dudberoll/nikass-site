---
import CookieNotice from "./CookieNotice.astro";
import StoreChat from "./StoreChat.astro";
const hideChat = ["/cart", "/checkout"].includes(Astro.url.pathname.replace(/\/$/, ""));
---
<footer class="store-footer" id="footer">
  <div>
    <a class="store-logo" href="/">NIKASS</a>
    <p>Автономная энергия для дома, дороги и работы.</p>
    <p>ИП Копаница Александр Викторович<br />ИНН 402809602074<br />ОГРНИП 311774617200097</p>
    <nav class="store-footer-legal" aria-labelledby="store-footer-legal-title">
      <h2 id="store-footer-legal-title">Правовая информация</h2>
      <div class="store-footer-legal-links">
        <a href="/privacy-policy">Политика конфиденциальности</a>
        <a href="/personal-data-consent">Согласие на обработку персональных данных</a>
        <a href="/advertising-consent">Информация о рекламных сообщениях</a>
      </div>
    </nav>
  </div>
  <nav class="store-footer-links" aria-label="Навигация сайта">
    <a href="/catalog">Каталог</a>
    <a href="/blog">Блог</a>
    <a href="/cart">Корзина</a>
    <a href="/about">О компании</a>
    <a href="/service-center">Сервисный центр</a>
    <a href="/payment-and-delivery">Оплата и доставка</a>
    <a href="/return-policy">Политика возврата</a>
    <a href="/#contacts">Связаться с нами</a>
  </nav>
  <small>© 2026 NIKASS. Все права защищены.</small>
</footer>
<CookieNotice />
{!hideChat && <StoreChat />}
