---
const metrikaId = "113580532";
---

<aside class="cookie-notice" data-cookie-notice data-metrika-id={metrikaId} aria-label="Уведомление об использовании файлов cookie">
  <p>Мы используем технические файлы cookie и аналогичные технологии для работы сайта и аналитики. Нажимая «Согласен», вы даёте согласие на их использование в соответствии с <a href="/privacy-policy">Политикой конфиденциальности</a>.</p>
  <button class="store-primary-button" type="button" data-metrika-consent="accepted">Согласен</button>
</aside>

<script is:inline>
  const cookieNotice = document.querySelector("[data-cookie-notice]");
  const cookieConsentName = "nikass_cookie_consent";
  const analyticsConsentName = "nikass_analytics_consent";
  const readCookie = (name) => document.cookie.split(";").map((cookie) => cookie.trim()).find((cookie) => cookie.startsWith(`${name}=`))?.slice(name.length + 1);
  const saveCookie = (name, value) => {
    document.cookie = `${name}=${value}; Max-Age=15552000; Path=/; SameSite=Lax${location.protocol === "https:" ? "; Secure" : ""}`;
  };
  const loadMetrika = (counterId) => {
    if (window.ym) return;
    (function (m, e, t, r, i, k, a) {
      m[i] = m[i] || function () { (m[i].a = m[i].a || []).push(arguments); };
      m[i].l = 1 * new Date();
      k = e.createElement(t);
      a = e.getElementsByTagName(t)[0];
      k.async = 1;
      k.src = `${r}?id=${counterId}`;
      a.parentNode.insertBefore(k, a);
    })(window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
    window.ym(counterId, "init", {
      ssr: true,
      webvisor: false,
      clickmap: false,
      referrer: document.referrer,
      url: location.href,
      accurateTrackBounce: true,
      trackLinks: true,
    });
  };

  if (cookieNotice instanceof HTMLElement) {
    const counterId = cookieNotice.dataset.metrikaId;
    if (counterId) {
      const analyticsConsent = readCookie(analyticsConsentName);
      cookieNotice.hidden = analyticsConsent === "accepted" || analyticsConsent === "rejected";
      if (analyticsConsent === "accepted") loadMetrika(counterId);
      cookieNotice.querySelector('[data-metrika-consent="accepted"]')?.addEventListener("click", () => {
        saveCookie(cookieConsentName, "accepted");
        saveCookie(analyticsConsentName, "accepted");
        loadMetrika(counterId);
        cookieNotice.hidden = true;
      });
    }
  }
</script>
