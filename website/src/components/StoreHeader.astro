---
import { ALL_PRODUCTS_LABEL, DISCOUNTED_PRODUCTS_LABEL, DISCOUNTED_PRODUCTS_PATH, HERO_CATEGORIES } from "../data/catalog";

const isHomePage = Astro.url.pathname === "/";
const DISCOUNTED_PRODUCTS_ICON = "/assets/images/category-icons/discounted-products.png";
const menuCategoryIcons = Object.fromEntries([
  ...HERO_CATEGORIES.map(({ label, icon }) => [label, icon] as const),
  [DISCOUNTED_PRODUCTS_LABEL, DISCOUNTED_PRODUCTS_ICON] as const,
]);
---

<header class="orbea-header orbea-header-light" data-header>
  <a class="skip-link" href="#main-content">К содержимому</a>
  <div class="orbea-header-inner">
    <button class="orbea-mobile-menu-button" type="button" aria-label="Открыть меню" data-open-menu>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    <nav class="orbea-desktop-nav" aria-label="Основная навигация">
      <div class="orbea-catalog-menu" data-catalog-menu>
        <button type="button" data-catalog-dropdown-toggle aria-expanded="false" aria-controls="orbea-catalog-dropdown">
          Каталог <span class="orbea-catalog-chevron" aria-hidden="true"></span>
        </button>
        <div class="orbea-catalog-dropdown" id="orbea-catalog-dropdown" hidden data-catalog-dropdown>
          <div class="orbea-catalog-dropdown-list">
            <a class="orbea-catalog-dropdown-link orbea-catalog-dropdown-all" href="/catalog" data-catalog-dropdown-link><span>{ALL_PRODUCTS_LABEL}</span>{!isHomePage && <span aria-hidden="true">↗</span>}</a>
            {HERO_CATEGORIES.map((category) => <a class="orbea-catalog-dropdown-link" href={`/catalog?category=${encodeURIComponent(category.label)}`} data-catalog-dropdown-link><span class="orbea-catalog-dropdown-label"><img src={category.icon} alt="" aria-hidden="true" /><span>{category.label}</span></span><span aria-hidden="true">›</span></a>)}
            <a class="orbea-catalog-dropdown-link" href={DISCOUNTED_PRODUCTS_PATH} data-catalog-dropdown-link><span class="orbea-catalog-dropdown-label"><img src={DISCOUNTED_PRODUCTS_ICON} alt="" aria-hidden="true" /><span>{DISCOUNTED_PRODUCTS_LABEL}</span></span><span aria-hidden="true">›</span></a>
          </div>
        </div>
      </div>
      <a href="/blog">Блог</a>
      <a href="/#custom">Как выбрать</a>
      <button type="button" data-open-menu="Commitment">О NIKASS</button>
    </nav>
    <a class="orbea-logo" href="/" aria-label="NIKASS — главная"><img class="orbea-logo-image" src="/assets/images/nikass-smart-selection-logo.png" alt="" /></a>
    <div class="orbea-actions">
      <button class="orbea-icon-button" type="button" aria-label="Поиск" data-search-open>
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
      </button>
      <a class="orbea-icon-button" href="/cart" aria-label="Корзина" data-cart-target>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 8h12l1 13H5L6 8Z" /><path d="M9 8V5a3 3 0 0 1 6 0v3" /></svg>
        <span class="orbea-cart-count" data-cart-count>0</span>
      </a>
    </div>
  </div>
  <div class="orbea-search-panel" hidden data-search-panel>
    <label for="orbea-search">Найти товар</label>
    <form action="/catalog"><input id="orbea-search" name="q" type="search" list="orbea-search-suggestions" placeholder="Название или артикул" /><button type="submit">Найти</button><button type="button" aria-label="Закрыть поиск" data-search-close>×</button></form>
    <datalist id="orbea-search-suggestions">
      {HERO_CATEGORIES.map(({ label }) => <option value={label} />)}
    </datalist>
  </div>
</header>

<div class="orbea-menu-backdrop" hidden data-menu-backdrop>
  <aside class="orbea-menu-panel" role="dialog" aria-modal="true" aria-label="Навигация NIKASS">
    <div class="orbea-menu-header">
      <button class="orbea-menu-back" type="button" hidden data-menu-back>← <span>Назад</span></button>
      <a class="orbea-menu-brand" href="/" aria-label="NIKASS — главная" data-menu-brand data-menu-anchor><img src="/assets/images/nikass-smart-selection-logo.png" alt="NIKASS" /></a>
      <strong class="orbea-menu-title" hidden>NIKASS</strong>
      <button class="orbea-icon-button" type="button" aria-label="Закрыть" data-menu-close>×</button>
    </div>
    <div class="orbea-menu-root" data-menu-root data-all-products-label={ALL_PRODUCTS_LABEL} data-discounted-label={DISCOUNTED_PRODUCTS_LABEL} data-discounted-path={DISCOUNTED_PRODUCTS_PATH} data-category-items={JSON.stringify([ALL_PRODUCTS_LABEL, ...HERO_CATEGORIES.map(({ label }) => label), DISCOUNTED_PRODUCTS_LABEL])} data-category-icons={JSON.stringify(menuCategoryIcons)}>
      <button class="orbea-menu-root-link" type="button" data-menu-section="Gear">Каталог <span>›</span></button>
      <a class="orbea-menu-root-link" href="/blog" data-menu-anchor>Блог</a>
      <a class="orbea-menu-root-link" href="/#custom" data-menu-anchor>Как выбрать</a>
      <button class="orbea-menu-root-link" type="button" data-menu-section="Commitment">О NIKASS <span>›</span></button>
      <a class="orbea-menu-root-link" href="/#contacts" data-menu-anchor>Контакты</a>
      <a class="orbea-menu-root-link" href="/#footer-documents" data-menu-anchor>Документы</a>
    </div>
    <div class="orbea-menu-detail" hidden data-menu-detail>
      <div class="orbea-menu-list" data-menu-list></div>
      <div class="orbea-menu-promo" hidden data-menu-promo>
        <img src="/assets/images/story-autonomous-system.webp" alt="" aria-hidden="true" />
        <div><span>NIKASS / ПРАКТИКА</span><strong>Как собрать автономную систему</strong><a href="/blog/how-to-build-an-autonomous-system" data-menu-anchor>Читать статью</a></div>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  const header = document.querySelector("[data-header]");
  const menuBackdrop = document.querySelector("[data-menu-backdrop]");
  const menuPanel = menuBackdrop.querySelector(".orbea-menu-panel");
  const menuRoot = document.querySelector("[data-menu-root]");
  const menuDetail = document.querySelector("[data-menu-detail]");
  const menuList = document.querySelector("[data-menu-list]");
  const menuPromo = document.querySelector("[data-menu-promo]");
  const menuBack = document.querySelector("[data-menu-back]");
  const menuBrand = document.querySelector("[data-menu-brand]");
  const menuTitle = document.querySelector(".orbea-menu-title");
  const allProductsLabel = menuRoot.dataset.allProductsLabel || "";
  const categoryIcons = JSON.parse(menuRoot.dataset.categoryIcons || "{}");
  const menuClose = document.querySelector("[data-menu-close]");
  const mobileMenuButton = document.querySelector(".orbea-mobile-menu-button");
  const pageRoot = header.closest(".orbea-page") || document.body;
  const searchPanel = document.querySelector("[data-search-panel]");
  const searchInput = document.querySelector("#orbea-search");
  const searchOpenButton = document.querySelector("[data-search-open]");
  const catalogDropdown = document.querySelector("[data-catalog-dropdown]");
  const catalogDropdownToggle = document.querySelector("[data-catalog-dropdown-toggle]");
  let lastMenuTrigger;
  let lastSearchTrigger;

  const pageChildren = () => [...pageRoot.children].filter((element) => element !== menuBackdrop);
  const syncOverflow = () => { document.body.style.overflow = !menuBackdrop.hidden || !searchPanel.hidden ? "hidden" : ""; };
  const closeCatalogDropdown = () => {
    if (!catalogDropdown || catalogDropdown.hidden) return;
    catalogDropdown.hidden = true;
    catalogDropdownToggle?.setAttribute("aria-expanded", "false");
  };
  catalogDropdownToggle?.addEventListener("click", (event) => {
    event.stopPropagation();
    const isOpen = !catalogDropdown.hidden;
    closeCatalogDropdown();
    if (!isOpen) {
      catalogDropdown.hidden = false;
      catalogDropdownToggle.setAttribute("aria-expanded", "true");
    }
  });
  catalogDropdown?.querySelectorAll("[data-catalog-dropdown-link]").forEach((link) => link.addEventListener("click", closeCatalogDropdown));
  const showMenuRoot = () => {
    menuTitle.textContent = "NIKASS";
    menuTitle.hidden = true;
    menuBrand.hidden = false;
    menuBack.hidden = true;
    menuRoot.hidden = false;
    menuDetail.hidden = true;
  };
  const showMenuSection = (section) => {
    menuTitle.textContent = section === "Gear" ? "Каталог" : "О NIKASS";
    menuTitle.hidden = false;
    menuBrand.hidden = true;
    menuBack.hidden = false;
    menuRoot.hidden = true;
    menuDetail.hidden = false;
    menuPromo.hidden = section !== "Gear";
    const items = section === "Gear" ? JSON.parse(menuRoot.dataset.categoryItems || "[]") : ["О компании", "Поддержка"];
    menuList.innerHTML = items.map((item) => `<a class="orbea-menu-detail-link" href="${section === "Commitment" ? (item === "О компании" ? "/about" : "/#footer") : item === allProductsLabel ? "/catalog" : item === menuRoot.dataset.discountedLabel ? menuRoot.dataset.discountedPath : `/catalog?category=${encodeURIComponent(item)}`}" data-menu-anchor><span class="orbea-menu-detail-label">${categoryIcons[item] ? `<img src="${categoryIcons[item]}" alt="" aria-hidden="true">` : ""}<span>${item}</span></span><span>›</span></a>`).join("");
    menuList.querySelectorAll("[data-menu-anchor]").forEach((link) => link.addEventListener("click", closeMenu));
  };
  const openMenu = (section) => {
    closeCatalogDropdown();
    lastMenuTrigger = document.activeElement;
    menuBackdrop.hidden = false;
    pageChildren().forEach((element) => { element.inert = true; });
    mobileMenuButton.setAttribute("aria-label", "Закрыть меню");
    section ? showMenuSection(section) : showMenuRoot();
    syncOverflow();
    requestAnimationFrame(() => menuClose.focus());
  };
  const closeMenu = () => {
    if (menuBackdrop.hidden) return;
    menuBackdrop.hidden = true;
    pageChildren().forEach((element) => { element.inert = false; });
    mobileMenuButton.setAttribute("aria-label", "Открыть меню");
    showMenuRoot();
    syncOverflow();
    if (lastMenuTrigger instanceof HTMLElement) lastMenuTrigger.focus();
  };
  document.querySelectorAll("[data-open-menu]").forEach((button) => button.addEventListener("click", () => openMenu(button.dataset.openMenu || "")));
  document.querySelectorAll("[data-menu-section]").forEach((button) => button.addEventListener("click", () => showMenuSection(button.dataset.menuSection)));
  document.querySelectorAll("[data-menu-anchor]").forEach((link) => link.addEventListener("click", closeMenu));
  menuClose.addEventListener("click", closeMenu);
  menuBack.addEventListener("click", showMenuRoot);
  menuBackdrop.addEventListener("click", closeMenu);
  menuPanel.addEventListener("click", (event) => event.stopPropagation());
  document.addEventListener("click", (event) => {
    if (!catalogDropdown || catalogDropdown.hidden || !(event.target instanceof Node)) return;
    if (!catalogDropdown.contains(event.target) && event.target !== catalogDropdownToggle) closeCatalogDropdown();
  });

  const trapFocus = (event, container) => {
    const focusable = [...container.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), textarea:not([disabled])')].filter((element) => element.offsetParent !== null);
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
  };

  const closeSearch = () => {
    if (searchPanel.hidden) return;
    searchPanel.hidden = true;
    syncOverflow();
    if (lastSearchTrigger instanceof HTMLElement) lastSearchTrigger.focus();
  };
  searchOpenButton.addEventListener("click", () => {
    if (!searchPanel.hidden) return closeSearch();
    closeCatalogDropdown();
    lastSearchTrigger = document.activeElement;
    searchPanel.hidden = false;
    syncOverflow();
    searchInput.focus();
  });
  document.querySelector("[data-search-close]").addEventListener("click", closeSearch);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Tab" && !menuBackdrop.hidden) trapFocus(event, menuPanel);
    if (event.key === "Escape") { closeMenu(); closeSearch(); closeCatalogDropdown(); }
  });
  const updateHeader = () => header.classList.toggle("is-scrolled", scrollY > 0);
  addEventListener("scroll", updateHeader, { passive: true });
  updateHeader();
</script>

<script>
  import { getCartCount, readCart, subscribeToCart } from "../lib/cart";
  const updateCart = () => document.querySelectorAll("[data-cart-count]").forEach((node) => { node.textContent = String(getCartCount(readCart().items)); });
  subscribeToCart(updateCart);
  updateCart();

  window.addEventListener("nikass:cart-item-added", (event) => {
    const { image, origin } = (event as CustomEvent<{ image: string; origin: HTMLElement }>).detail;
    const target = document.querySelector<HTMLElement>("[data-cart-target]");
    if (!image || !origin || !target || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const from = origin.getBoundingClientRect();
    const to = target.getBoundingClientRect();
    const item = document.createElement("img");
    item.className = "cart-fly-image";
    item.src = image;
    item.alt = "";
    item.setAttribute("aria-hidden", "true");
    item.style.left = `${from.left + from.width / 2 - 20}px`;
    item.style.top = `${from.top + from.height / 2 - 20}px`;
    document.body.append(item);

    const animation = item.animate([
      { transform: "translate(0, 0) scale(1)", opacity: 1, offset: 0, easing: "cubic-bezier(.3, .7, .2, 1)" },
      { transform: `translate(${(to.left + to.width / 2 - from.left - from.width / 2) * .78}px, ${(to.top + to.height / 2 - from.top - from.height / 2) * .78 - 30}px) scale(.72)`, opacity: .9, offset: .72, easing: "cubic-bezier(.4, 0, .8, .2)" },
      { transform: `translate(${to.left + to.width / 2 - from.left - from.width / 2}px, ${to.top + to.height / 2 - from.top - from.height / 2}px) scale(.2)`, opacity: 0, offset: 1 },
    ], { duration: 1400, easing: "linear" });
    animation.onfinish = () => {
      item.remove();
      document.querySelector("[data-cart-count]")?.animate(
        [{ transform: "scale(1)" }, { transform: "scale(1.4)" }, { transform: "scale(1)" }],
        { duration: 280, easing: "ease-out" },
      );
    };
  });
</script>
