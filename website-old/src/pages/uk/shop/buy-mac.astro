---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BuyMacPage from '@/components/apple/BuyMacPage'
import '@/styles/apple.css'
const websiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = websiteUrl ? new URL(Astro.url.pathname, websiteUrl).toString() : undefined
---
<BaseLayout title="Shop Mac - Apple UK" description="A local recreation of selected Apple UK Store pages." canonicalUrl={canonicalUrl}>
  <BuyMacPage client:load />
</BaseLayout>
