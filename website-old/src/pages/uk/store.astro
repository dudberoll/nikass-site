---
import BaseLayout from '@/layouts/BaseLayout.astro'
import StorePage from '@/components/apple/StorePage'
import '@/styles/apple.css'
const websiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = websiteUrl ? new URL(Astro.url.pathname, websiteUrl).toString() : undefined
---
<BaseLayout title="Apple UK Store" description="A local recreation of selected Apple UK Store pages." canonicalUrl={canonicalUrl}>
  <StorePage client:load />
</BaseLayout>
