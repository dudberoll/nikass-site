---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CatalogPagination from '@/components/catalog/CatalogPagination.astro'
import NikassFooter from '@/components/catalog/NikassFooter.astro'
import NikassHeader from '@/components/catalog/NikassHeader.astro'
import { CATALOG_PAGE_SIZE, CatalogGrid, PRODUCTS, paginateProducts } from '@/features/catalog'
import '@/styles/catalog.css'

interface Props {
  page: number
}

export function getStaticPaths() {
  const { pageCount } = paginateProducts(PRODUCTS, 1, CATALOG_PAGE_SIZE)

  return Array.from({ length: Math.max(0, pageCount - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { page: index + 2 },
  }))
}

const { page } = Astro.props
const pageData = paginateProducts(PRODUCTS, page, CATALOG_PAGE_SIZE)
const websiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = websiteUrl ? new URL(Astro.url.pathname, websiteUrl).toString() : undefined
---

<BaseLayout
  lang="ru"
  title={`Каталог NIKASS — страница ${page}`}
  description="HTML-версия каталога NIKASS с товарами для автономной жизни."
  canonicalUrl={canonicalUrl}
>
  <div class="catalog-page">
    <NikassHeader active="catalog" />

    <main id="main-content">
      <section class="catalog-products catalog-html-page" aria-labelledby="catalog-page-title">
        <div class="catalog-container">
          <p class="catalog-eyebrow">NIKASS / КАТАЛОГ</p>
          <h1 id="catalog-page-title">Каталог NIKASS</h1>
          <p class="catalog-html-page__description">
            Страница {page} из {pageData.pageCount}. Для фильтров и поиска вернитесь в полный каталог.
          </p>
          <CatalogGrid products={pageData.items} client:load />
          <CatalogPagination currentPage={pageData.page} pageCount={pageData.pageCount} />
        </div>
      </section>
    </main>

    <NikassFooter />
  </div>
</BaseLayout>
