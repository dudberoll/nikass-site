---
import BaseLayout from '@/layouts/BaseLayout.astro'
import NikassFooter from '@/components/catalog/NikassFooter.astro'
import ProductPage from '@/components/catalog/ProductPage.astro'
import NikassHeader from '@/components/catalog/NikassHeader.astro'
import { PRODUCTS } from '@/features/catalog'
import '@/styles/catalog.css'

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }))
}

const { product } = Astro.props
const websiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = websiteUrl ? new URL(Astro.url.pathname, websiteUrl).toString() : undefined
---

<BaseLayout
  lang="ru"
  title={`${product.name} — NIKASS`}
  description={product.shortDescription}
  canonicalUrl={canonicalUrl}
>
  <div class="catalog-page">
    <NikassHeader active="catalog" />
    <ProductPage product={product} />
    <NikassFooter />
  </div>
</BaseLayout>
