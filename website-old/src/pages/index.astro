---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { CatalogGrid, CATEGORIES, PRODUCTS } from '@/features/catalog'
import NikassFooter from '@/components/catalog/NikassFooter.astro'
import NikassHeader from '@/components/catalog/NikassHeader.astro'
import '@/styles/catalog.css'
import '@/styles/storefront.css'

const websiteUrl = import.meta.env.PUBLIC_WEBSITE_URL
const canonicalUrl = websiteUrl ? new URL(Astro.url.pathname, websiteUrl).toString() : undefined
---

<BaseLayout
  lang="ru"
  title="NIKASS — энергия для автономной жизни"
  description="Электроника NIKASS для дома, дороги и автономной жизни."
  canonicalUrl={canonicalUrl}
>
  <div class="catalog-page nikass-home">
    <NikassHeader active="home" />

    <main id="main-content">
      <section class="nikass-home__hero" aria-labelledby="home-title">
        <div class="catalog-container">
          <p class="catalog-eyebrow">ЭНЕРГИЯ, КОТОРАЯ РЯДОМ</p>
          <h1 id="home-title">Независимость<br /><em>в каждом ватте.</em></h1>
          <p>
            Электроника для дома, дороги и автономной жизни. Локальная демонстрационная витрина NIKASS.
          </p>
          <a class="nikass-button" href="/catalog">Смотреть каталог →</a>
        </div>
        <div class="nikass-home__orb" aria-hidden="true"><strong>N<span>⚡</span>S</strong></div>
      </section>

      <section class="nikass-home__featured" aria-labelledby="featured-title">
        <div class="catalog-container">
          <div class="nikass-home__section-heading">
            <div>
              <p class="catalog-eyebrow">ПОПУЛЯРНОЕ</p>
              <h2 id="featured-title">Выберите свою энергию</h2>
            </div>
            <a href="/catalog">Весь каталог →</a>
          </div>
          <CatalogGrid products={PRODUCTS.slice(0, 4)} client:load />
        </div>
      </section>

      <section class="nikass-home__categories" aria-labelledby="home-categories-title">
        <div class="catalog-container">
          <div class="nikass-home__section-heading">
            <div>
              <p class="catalog-eyebrow">ПЯТЬ НАПРАВЛЕНИЙ</p>
              <h2 id="home-categories-title">Соберите свою систему</h2>
            </div>
            <a href="/catalog">Все категории →</a>
          </div>
          <div class="nikass-home__category-grid">
            {CATEGORIES.map((category) => (
              <a class="nikass-home__category" href="/catalog">
                <img src={category.image} alt="" loading="lazy" />
                <span>{category.name}</span>
                <small>{category.description}</small>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <NikassFooter />
  </div>
</BaseLayout>
